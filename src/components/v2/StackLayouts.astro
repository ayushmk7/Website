---
import { skillGroups } from '../../lib/profile';
---
<div class="news-grid">
  {skillGroups.map((group) => (
    <div class="news">
      <h3 class="news-head">{group.label}</h3>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem">{group.featured.map((s) => <span class="skill-tag">{s}</span>)}</div>
    </div>
  ))}
</div>
