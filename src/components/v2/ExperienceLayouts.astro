---
// Experience — newspaper clippings (same skin as Projects / Hackathons / Stack).
import { experience } from '../../data/v2';
import ProjectLinks from './ProjectLinks.astro';
---
<div class="news-grid">
  {experience.map((j) => (
    <div class="news">
      <div class="news-kicker"><span>{j.kind}{j.location ? ` · ${j.location}` : ''}</span><span>{j.period}</span></div>
      <h3 class="news-head">{j.company}</h3>
      <p class="trophy-place" style="margin-bottom:0.4rem">{j.role}{j.badge && <span class="vbadge">{j.badge}</span>}</p>
      <ul class="vbul news-body" style="margin-bottom:0.6rem">{j.bullets.map((b) => <li>{b}</li>)}</ul>
      <ProjectLinks p={{ title: j.company, websiteUrl: j.url }} />
    </div>
  ))}
</div>
