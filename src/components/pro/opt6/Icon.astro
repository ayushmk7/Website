---
// src/components/pro/opt6/Icon.astro — tiny inline SVG set for Option 6 (decorative; always aria-hidden).
interface Props { name: 'github' | 'external' | 'sun' | 'moon' | 'file' | 'spark'; size?: number }
const { name, size = 14 } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{name === 'github' && (
  <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size} fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>
)}
{name === 'external' && (
  <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size} {...stroke}><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
)}
{name === 'sun' && (
  <svg class="ico-sun" aria-hidden="true" viewBox="0 0 24 24" width={size} height={size} {...stroke}><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
)}
{name === 'moon' && (
  <svg class="ico-moon" aria-hidden="true" viewBox="0 0 24 24" width={size} height={size} {...stroke}><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
)}
{name === 'file' && (
  <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size} {...stroke}><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h8"/></svg>
)}
{name === 'spark' && (
  <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size} {...stroke}><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
)}

<style>
  /* sun shows in light, moon in dark (the toggle only flips html.dark) */
  .ico-moon { display: none; }
  :global(html.dark) .ico-sun { display: none; }
  :global(html.dark) .ico-moon { display: inline; }
</style>
