  .hk__place :global(svg) { margin-top: 3px; }
  .hk__proj { font-size: 15px; }
  .hk__blurb { font-size: 13.5px; color: var(--muted); line-height: 1.55; }
  .hk__tags { font-size: 11.5px; overflow-wrap: anywhere; }
  .hk__links { margin-top: auto; padding-top: .5rem; }

  /* skills */
  .sk-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
  .sk { padding: 1rem; display: flex; flex-direction: column; gap: .7rem; min-width: 0; }
  .sk h3 { color: var(--muted); font-weight: 400; }
