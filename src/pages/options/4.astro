  /* education */
  .edu { padding: 1.25rem clamp(1rem, 3vw, 1.5rem); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; align-items: center; }
  .edu p { margin-top: .25rem; }
  .edu__meta { text-align: right; font-size: 14px; }
  .edu__meta .muted { display: inline-flex; align-items: center; gap: .3rem; }

  /* contact */
  .contact { padding: clamp(1.75rem, 5vw, 3rem) clamp(1rem, 4vw, 2rem); text-align: center; display: flex; flex-direction: column; align-items: center; gap: .8rem; }
