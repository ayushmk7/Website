  .contact__avail { color: var(--muted); max-width: 46ch; }
  .contact__mail { display: inline-flex; align-items: center; gap: .5rem; font-size: clamp(1.05rem, 3vw, 1.5rem); font-weight: 500; letter-spacing: -.01em; margin-top: .4rem; overflow-wrap: anywhere; max-width: 100%; }
  .contact__mail .link { color: var(--blue); text-decoration-color: var(--blue); }
  .contact__links { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin-top: .6rem; }
  .contact__links .muted { margin-left: .1rem; font-size: 12px; }
  .btn:hover .muted { color: var(--blue); }

  /* footer */
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 1.5rem; padding-block: 3rem 5rem; font-size: 13.5px; border-top: 1px solid var(--border); margin-top: 4rem; }
  .foot p { display: inline-flex; align-items: center; gap: .75rem; }
  .foot nav { display: flex; gap: 1.25rem; }
  .foot .link { min-height: 40px; }

  /* ---------- palette ---------- */
  .pal { width: min(560px, calc(100vw - 2rem)); margin: 12vh auto auto; padding: 0; border: 1px solid var(--fg); border-radius: 0; background: var(--bg); color: var(--fg); }
  .pal::backdrop { background: rgba(0, 0, 0, .5); }
  .pal__head { display: flex; align-items: center; gap: .6rem; padding: .6rem .9rem; border-bottom: 1px solid var(--border); color: var(--muted); }
  .pal__head input { flex: 1; min-width: 0; background: transparent; border: 0; color: var(--fg); font: inherit; font-size: 15px; padding: .45rem 0; }
  .pal__head input:focus { outline: none; }
  .pal__head input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
  .pal__head kbd { font-family: var(--mono); font-size: 11px; background: var(--bg); border: 1px solid var(--border); padding: .15rem .4rem; }
  .pal__body { padding: .5rem; max-height: min(60vh, 480px); overflow-y: auto; }
  .pal__group { padding: .35rem .4rem .5rem; }
  .pal__group .lbl { padding: .2rem .5rem .4rem; }
  .pal__group li > a, .pal__group li > button { display: flex; width: 100%; align-items: center; gap: .6rem; min-height: 40px; padding: .4rem .6rem; border: 1px solid transparent; background: transparent; color: var(--fg); font: inherit; font-size: 14px; text-align: left; cursor: pointer; }
  .pal__group li > a :global(svg), .pal__group li > button :global(svg) { color: var(--muted); }
  .pal__group li > a:hover, .pal__group li > button:hover { color: var(--blue); border-color: var(--blue); }
  .pal__group li > a:focus-visible, .pal__group li > button:focus-visible { color: var(--blue); border-color: var(--blue); outline: 2px solid var(--blue); outline-offset: -2px; }
  .pal__group .muted { margin-left: auto; font-size: 12px; }

  /* ---------- responsive ---------- */
  @media (min-width: 560px) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sk-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 720px) {
