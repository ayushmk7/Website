    .hk--lead { grid-column: 1 / -1; flex-direction: row; gap: clamp(1.5rem, 4vw, 3rem); padding: clamp(1.25rem, 3vw, 1.75rem); }
    .hk--lead .hk__head { flex: 0 0 38%; }
    .hk--lead .hk__blurb { font-size: 14.5px; max-width: 62ch; }
    .hk--lead h3 { font-size: 20px; letter-spacing: -.02em; }
  }
  @media (min-width: 900px) {
    .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
