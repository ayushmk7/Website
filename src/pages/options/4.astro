    .only-mob { display: inline; }
    .btn--fun { width: 36px; padding: 0; }
  }
  @media (max-width: 767px) {
    .xp__row { grid-template-columns: 1fr; gap: .5rem; }
    .xp__meta { grid-auto-flow: column; justify-content: start; gap: .75rem; }
