  /* contact + footer */
  .s9-contact .s9-cell { font: 600 clamp(1.25rem, 2.4vw, 1.75rem)/1.3 var(--font); letter-spacing: -0.015em; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 0; }
