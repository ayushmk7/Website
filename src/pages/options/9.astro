<script is:inline>
  (function () {
    var root = document.documentElement;
    document.querySelectorAll('[data-invert]').forEach(function (b) {
      b.addEventListener('click', function () {
        var dark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      });
    });
    document.querySelectorAll('[data-copy]').forEach(function (b) {
      var label = b.textContent;
      b.addEventListener('click', function () {
        var text = b.getAttribute('data-copy') || '';
        var done = function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = label; }, 1500); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, function () { location.href = 'mailto:' + text; });
        else location.href = 'mailto:' + text;
      });
    });
  })();
</script>
