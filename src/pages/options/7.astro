---
// src/pages/options/7.astro — Option 7 "Original": faithful revival of the site's pre-comic design
// (git 40a5f35): white/black/blue minimal, thick 4px rounded cards, blue icon squares, mono tag pills,
// full-screen centered hero, collapsible skills, "Show More Projects". Filled with today's content.
// Content comes only from ../../lib/profile (the shared contract), nothing from the raw data files.
//
// Adaptations from the original (which had no slot for these): Hackathons is a new card in the same
// visual language, Skills shows every skill per category (as the original did), the résumé preview is
// the original's "PDF ↗" link (no react-pdf), lucide icons are inline SVGs (components/pro/opt7/Icon).
import ProLayout from '../../layouts/ProLayout.astro';
import OptionSwitcher from '../../components/OptionSwitcher.astro';
import Icon from '../../components/pro/opt7/Icon.astro';
import {
  profile, contactLinks, education, experience, hackathonsWithProject,
  featuredProjects, moreProjects, skillGroups, FUN_HREF,
} from '../../lib/profile';

// The original hero row had exactly four buttons: mail, GitHub, LinkedIn, theme. (No X, no résumé.)
const social = contactLinks.filter((l) => l.key === 'github' || l.key === 'linkedin');
const iconFor: Record<string, 'github' | 'linkedin'> = { github: 'github', linkedin: 'linkedin' };
// Hero copy: verbatim from the original HeroSection.astro (40a5f35), punctuation included.
const aboutMe = [
  'Full-stack software developer with a focus on systems programming and AI infrastructure.',
  'Currently helping accelerate the development of on-device AI at Cactus (YC S25). Passionate software developer with experience in modern web technologies and machine learning. I love building innovative solutions that solve real-world problems .',
];

// Shared class strings (the original used clsx/twMerge; plain strings do the same job here).
const iconBtn = 'inline-flex p-3 rounded-lg border-2 border-foreground bg-background hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-colors duration-200';
const pillBtn = 'inline-flex items-center gap-2 px-6 py-3 rounded-2xl border-2 border-foreground bg-background hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-colors duration-200 text-lg font-medium';
const card = 'w-full bg-background border-4 border-black dark:border-white rounded-3xl p-6 md:p-8 shadow-lg';
const entry = 'border-2 border-black dark:border-white rounded-2xl p-6 transition-colors duration-300 hover:border-blue-600 dark:hover:border-blue-500';
const smallIconLink = 'shrink-0 inline-flex p-2 rounded-lg border border-foreground hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-colors duration-200';
const projectCard = 'border-2 border-foreground rounded-2xl p-6 hover:border-blue-600 transition-colors duration-200 relative group flex flex-col bg-background';
const monoTag = 'px-3 py-1 text-sm rounded-full border border-foreground bg-background font-mono';
const blue = 'text-blue-600 dark:text-blue-400';
---
<ProLayout title={`${profile.name} — ${profile.headline}`} bodyClass="opt7">
  <a class="skip" href="#resume">Skip to content</a>

  <div class="min-h-screen">
    <!-- Hero -->
    <section class="min-h-screen flex flex-col justify-center items-center px-4 md:px-8" aria-labelledby="hero-name">
      <div class="max-w-2xl mx-auto text-center">
        <div class="w-32 h-3 bg-blue-600 rounded-full mx-auto mb-6" aria-hidden="true"></div>
        <h1 id="hero-name" class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight mb-6 text-foreground">{profile.name}</h1>
        <div class="space-y-4 text-lg md:text-xl mb-8">
          {aboutMe.map((paragraph) => <p class="text-foreground font-normal leading-relaxed">{paragraph}</p>)}
        </div>

        <div class="flex justify-center gap-4 mb-12 flex-wrap" role="group" aria-label="Contact links and theme">
          <div class="relative email-wrap">
            <button type="button" class={iconBtn} aria-label="Email" aria-expanded="false" aria-controls="email-pop" data-email-toggle>
              <Icon name="mail" class="w-6 h-6" />
            </button>
            <div id="email-pop" class="email-pop absolute bottom-full left-1/2 -translate-x-1/2 mb-2 z-50" hidden>
              <div class="bg-background border-4 border-foreground rounded-2xl p-2 flex items-center gap-2 shadow-lg whitespace-nowrap">
                <a class="text-sm font-medium px-2 hover:text-blue-600 dark:hover:text-blue-400 underline decoration-2 underline-offset-4" href={`mailto:${profile.email}`}>{profile.email}</a>
                <button type="button" class="copy-btn p-1.5 rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-200" data-copy={profile.email} aria-label={`Copy email address ${profile.email}`}>
                  <span class="copy-idle"><Icon name="copy" class="w-4 h-4" /></span>
                  <span class="copy-done"><Icon name="check" class="w-4 h-4" /></span>
                </button>
              </div>
              <div class="email-arrow absolute top-full left-1/2 -translate-x-1/2 -mt-[2px]" aria-hidden="true">
                <div class="w-0 h-0 border-l-[10px] border-r-[10px] border-t-[10px] border-l-transparent border-r-transparent border-t-foreground"></div>
              </div>
            </div>
          </div>
          {social.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer" class={iconBtn} aria-label={l.label}>
              <Icon name={iconFor[l.key]} class="w-6 h-6" />
            </a>
          ))}
          <button type="button" class={iconBtn} data-theme-toggle aria-label="Switch to dark theme">
            <span class="when-light"><Icon name="moon" class="w-6 h-6" /></span>
            <span class="when-dark"><Icon name="sun" class="w-6 h-6" /></span>
          </button>
        </div>

        <nav class="flex justify-center flex-wrap gap-4 mb-8" aria-label="Jump to section">
          <a href="#resume" class={pillBtn}>Resume</a>
          <a href="#projects" class={pillBtn}>Projects</a>
        </nav>
        <a href="#resume" class="flex flex-col items-center gap-1 cursor-pointer hover:opacity-80 transition-opacity" aria-label="Scroll to resume">
          <span class="text-foreground text-sm animate-bounce motion-reduce:animate-none">Scroll</span>
          <Icon name="chevron-down" class="w-5 h-5 text-foreground animate-bounce motion-reduce:animate-none" />
        </a>
      </div>
    </section>

    <div class="max-w-7xl mx-auto p-4 md:p-8 space-y-12">
      <!-- Resume -->
      <section id="resume" class="px-4 py-8 md:px-6 md:py-12 lg:px-8" aria-labelledby="resume-heading">
        <div class="max-w-6xl mx-auto flex flex-col items-center space-y-6">
          <header class="text-center w-full">
            <div class="w-16 h-1 bg-blue-600 rounded-full mx-auto mb-4" aria-hidden="true"></div>
            <h2 id="resume-heading" class="text-3xl md:text-4xl lg:text-5xl font-medium tracking-tight">Resume</h2>
            <p class="text-muted-foreground mt-2">Professional Experience &amp; Qualifications</p>
            <a href={profile.resumeHref} target="_blank" rel="noopener noreferrer" class={`inline-block mt-3 ${blue} underline hover:no-underline transition-[text-decoration] duration-200`}>PDF ↗</a>
          </header>

          <!-- Experience -->
          <article id="experience" class={card} aria-labelledby="experience-heading">
            <div class="flex items-center gap-3 mb-6">
              <div class="p-2 bg-blue-600 rounded-lg shrink-0" aria-hidden="true"><Icon name="briefcase" class="h-5 w-5 text-white" /></div>
              <h3 id="experience-heading" class="text-2xl md:text-3xl font-medium">Experience</h3>
            </div>
            <ul class="space-y-6">
              {experience.map((job) => (
                <li>
                  <div class={entry}>
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-1 mb-2">
                      <div>
                        <h4 class="text-lg font-bold flex flex-wrap items-center gap-x-2 gap-y-1">
                          {job.url
                            ? <a href={job.url} target="_blank" rel="noopener noreferrer" class="text-inherit no-underline hover:underline decoration-2 underline-offset-4">{job.company}</a>
                            : job.company}
                          {job.badge && <span class="badge">{job.badge}</span>}
                        </h4>
                        <p class={blue}>{job.role}</p>
                      </div>
                      <span class="text-muted-foreground text-sm shrink-0">{job.period}</span>
                    </div>
                    <p class="text-muted-foreground text-sm mb-3">{job.location ? `${job.location} · ` : ''}{job.kind}</p>
                    <ul class="space-y-2 list-none">
                      {job.bullets.map((item) => (
                        <li class="flex gap-2 leading-relaxed">
                          <span class={`${blue} mt-1.5 shrink-0`} aria-hidden="true">•</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))}
            </ul>
          </article>

          <!-- Education -->
          <article id="education" class={card} aria-labelledby="education-heading">
            <div class="flex items-center gap-3 mb-6">
              <div class="p-2 bg-blue-600 rounded-lg shrink-0" aria-hidden="true"><Icon name="graduation" class="h-5 w-5 text-white" /></div>
              <h3 id="education-heading" class="text-2xl md:text-3xl font-medium">Education</h3>
            </div>
            <ul class="space-y-6">
              {education.map((ed) => (
                <li>
                  <div class={entry}>
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-1">
                      <div>
                        <h4 class="text-lg font-bold">
                          {ed.url
                            ? <a href={ed.url} target="_blank" rel="noopener noreferrer" class="text-inherit no-underline hover:underline decoration-2 underline-offset-4">{ed.institution}</a>
                            : ed.institution}
                        </h4>
                        <p class={blue}>{ed.degree}</p>
                      </div>
                      <span class="text-muted-foreground text-sm shrink-0">{ed.period}</span>
                    </div>
                    {ed.location && <p class="text-muted-foreground text-sm mt-2">{ed.location}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </article>

          <!-- Hackathons (new card; same language as the original's "Projects / Contributions") -->
          <article id="hackathons" class={card} aria-labelledby="hackathons-heading">
            <div class="flex items-center gap-3 mb-6">
              <div class="p-2 bg-blue-600 rounded-lg shrink-0" aria-hidden="true"><Icon name="trophy" class="h-5 w-5 text-white" /></div>
              <h3 id="hackathons-heading" class="text-2xl md:text-3xl font-medium">Hackathons</h3>
            </div>
            <ol class="space-y-6">
              {hackathonsWithProject.map((h) => (
                <li>
                  <div class={entry}>
                    <div class="flex flex-row items-start justify-between gap-3">
                      <div class="min-w-0 flex-1">
                        <h4 class="text-lg font-bold">{h.event}</h4>
                        <p class={blue}>{h.placement}{h.prize && ` · ${h.prize}`}</p>
                        <p class="text-muted-foreground text-sm mt-1">{h.organizer} · {h.date}</p>
                      </div>
                      {(h.siteUrl || h.repoUrl) && (
                        <div class="flex gap-2 shrink-0">
                          {h.siteUrl && (
                            <a href={h.siteUrl} target="_blank" rel="noopener noreferrer" class={smallIconLink} aria-label={`Visit ${h.project} website`}>
                              <Icon name="external" class="h-4 w-4" />
                            </a>
                          )}
                          {h.repoUrl && (
                            <a href={h.repoUrl} target="_blank" rel="noopener noreferrer" class={smallIconLink} aria-label={`View ${h.project} on GitHub`}>
                              <Icon name="github" class="h-4 w-4" />
                            </a>
                          )}
                        </div>
                      )}
                    </div>
                    <ul class="space-y-2 list-none mt-3">
                      <li class="flex gap-2 leading-relaxed">
                        <span class={`${blue} mt-1.5 shrink-0`} aria-hidden="true">•</span>
                        <span><strong class="font-bold">{h.project}</strong> — {h.blurb}</span>
                      </li>
                    </ul>
                    {h.projectEntry?.tags?.length ? (
                      <div class="flex flex-wrap gap-2 mt-4">
                        {h.projectEntry.tags.map((tag) => <span class={monoTag}>{tag}</span>)}
                      </div>
                    ) : null}
                  </div>
                </li>
              ))}
            </ol>
          </article>

          <!-- Technical Skills (collapsible, as the original) -->
          <article id="skills" class={`skills-article ${card}`} aria-labelledby="skills-heading">
            <button type="button" class="skills-trigger w-full flex flex-row items-center mb-0 text-left cursor-pointer rounded-lg transition-colors" aria-expanded="false" aria-controls="skills-content">
              <span class="skills-trigger-heading flex-1 min-w-0">
                <span class="skills-trigger-heading-inner flex items-center gap-3">
                  <span class="p-2 bg-blue-600 rounded-lg shrink-0" aria-hidden="true"><Icon name="code" class="h-5 w-5 text-white" /></span>
                  <h3 id="skills-heading" class="text-2xl md:text-3xl font-medium">Technical Skills</h3>
                </span>
              </span>
              <span class="skills-expand-hint flex items-center gap-1 shrink-0">
                <span class="text-foreground text-sm animate-bounce motion-reduce:animate-none">Expand</span>
                <Icon name="chevron-down" class="w-5 h-5 text-foreground animate-bounce motion-reduce:animate-none" />
              </span>
              <span class="skills-collapse-hint flex items-center gap-1 shrink-0">
                <span class="text-foreground text-sm">Collapse</span>
                <Icon name="chevron-up" class="w-5 h-5 text-foreground" />
              </span>
            </button>
            <div id="skills-content" class="skills-content" role="region" aria-labelledby="skills-heading">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {skillGroups.map((g) => (
                  <div class="border-2 border-black dark:border-white rounded-2xl p-5">
                    <h4 class="text-lg font-medium mb-3">{g.label}</h4>
                    <div class="flex flex-wrap gap-2">
                      {g.all.map((skill) => (
                        <span class="rounded-full px-3 py-1 text-sm border-2 border-black dark:border-white">{skill}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- Projects -->
      <section id="projects" class="bg-background border-4 border-foreground rounded-3xl p-4 md:p-8" aria-labelledby="projects-heading">
        <div class="w-12 h-1 bg-blue-600 rounded-full mb-6" aria-hidden="true"></div>
        <h2 id="projects-heading" class="text-2xl md:text-3xl mb-8 font-medium">Projects</h2>

        <div class="space-y-12">
          <!-- One 1/2/3-column grid, as the original ProjectsList: only the first row (1/2/3 cards per
               breakpoint) is visible until "Show More Projects". Featured projects come first. -->
          <ul id="more-projects" class="proj-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" aria-label="Projects">
            {[...featuredProjects, ...moreProjects].map((p) => (
              <li class={projectCard}>
                <div class="absolute top-4 right-4 flex gap-2">
                  {p.websiteUrl && (
                    <a href={p.websiteUrl} target="_blank" rel="noopener noreferrer" class={smallIconLink} aria-label={`Visit ${p.title} website`}><Icon name="external" class="w-4 h-4" /></a>
                  )}
                  {p.githubUrl && (
                    <a href={p.githubUrl} target="_blank" rel="noopener noreferrer" class={smallIconLink} aria-label={`View ${p.title} on GitHub`}><Icon name="github" class="w-4 h-4" /></a>
                  )}
                </div>
                <h3 class={`text-xl font-bold mb-3 ${p.websiteUrl && p.githubUrl ? 'pr-24' : 'pr-12'}`}>{p.title}</h3>
                <p class="text-muted-foreground mb-6 flex-grow">{p.description}</p>
                <div class="flex flex-wrap gap-2 mt-auto">
                  {p.tags.map((tag) => <span class={monoTag}>{tag}</span>)}
                </div>
              </li>
            ))}
          </ul>

          <div class="flex justify-center">
            <button type="button" class={`group ${pillBtn} transition-all`} data-more-toggle aria-expanded="false" aria-controls="more-projects">
              <span class="more-idle inline-flex items-center gap-2">Show More Projects <Icon name="chevron-down" class="w-5 h-5 group-hover:translate-y-1 transition-transform" /></span>
              <span class="more-open inline-flex items-center gap-2">Show Less <Icon name="chevron-up" class="w-5 h-5 group-hover:-translate-y-1 transition-transform" /></span>
            </button>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <!-- Contact: the original ContactFooter ("Let's connect at … [copy]"), plus the availability line
           above it and a small "Fun mode ↗" text link below in the original's own link style (the blue
           underlined "PDF ↗" link). Least intrusive way to keep the link visible without inventing UI. -->
      <footer id="contact" class="flex flex-col items-center gap-4 py-12 text-center" aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="sr-only">Contact</h2>
        <p class="text-muted-foreground text-sm">{profile.availability}</p>
        <p class="text-lg font-medium text-foreground flex flex-wrap items-center justify-center gap-3">
          <span>Let's connect at</span>
          <a href={`mailto:${profile.email}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors underline decoration-2 underline-offset-4 break-all">{profile.email}</a>
          <button type="button" class="copy-btn group relative p-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200 shadow-md hover:shadow-lg active:scale-95" data-copy={profile.email} aria-label={`Copy email address ${profile.email}`}>
            <span class="copy-idle"><Icon name="copy" class="w-5 h-5" /></span>
            <span class="copy-done"><Icon name="check" class="w-5 h-5" /></span>
            <span class="tip absolute -top-10 left-1/2 -translate-x-1/2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 transition-opacity whitespace-nowrap pointer-events-none group-hover:opacity-100" aria-hidden="true">
              <span class="copy-idle">Copy Email</span><span class="copy-done">Copied!</span>
            </span>
          </button>
        </p>
        <p class="text-sm">
          <a class={`${blue} underline hover:no-underline transition-[text-decoration] duration-200`} href={FUN_HREF} title="Switch to the comic version of this site">Fun mode ↗</a>
        </p>
      </footer>
    </div>
  </div>

  <OptionSwitcher />
</ProLayout>

<style>
  /* ---------- tokens: the original global.css :root / .dark palette, scoped to this page ---------- */
  :global(body.opt7) {
    --background: #ffffff;
    --foreground: oklch(0.145 0 0);
    --muted-foreground: #717182;
    --border: rgba(0, 0, 0, 0.1);
    --radius: 0.625rem;
    color-scheme: light;
    margin: 0;
    min-height: 100vh;
    background: var(--background);
    color: var(--foreground);
  }
  /* The original global.css @layer base typography (h1/h2/h3/p/button sizes). Wrapped in :where() so it
     keeps zero specificity like a Tailwind base layer and never beats a utility class, exactly as before.
     This is what made the original hero paragraphs 16px despite the text-lg/xl wrapper. */
  :global(:where(body.opt7) h1) { font-size: 1.5rem; line-height: 1.5; font-weight: 500; }
  :global(:where(body.opt7) h2) { font-size: 1.25rem; line-height: 1.5; font-weight: 500; }
  :global(:where(body.opt7) h3) { font-size: 1.125rem; line-height: 1.5; font-weight: 500; }
  :global(:where(body.opt7) :is(h4, p, label, button, input)) { font-size: 1rem; line-height: 1.5; }
  :global(:where(body.opt7) :is(h4, label, button)) { font-weight: 500; }
  :global(:where(body.opt7) :is(p, input)) { font-weight: 400; }
  :global(html.dark body.opt7) {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --border: oklch(0.269 0 0);
    color-scheme: dark;
  }
  :global(html) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
  :global(body.opt7 #resume) { scroll-margin-top: 0; }
  :global(body.opt7 #projects) { scroll-margin-top: 1rem; }

  /* focus: blue ring, visible against black borders in both themes */
  :global(body.opt7 :is(a, button):focus-visible) {
    outline: 3px solid #2563eb;
    outline-offset: 2px;
  }
  :global(html.dark body.opt7 :is(a, button):focus-visible) { outline-color: #60a5fa; }

  .skip {
    position: absolute; left: 1rem; top: -3rem; z-index: 10;
    padding: 0.4rem 0.7rem; background: var(--foreground); color: var(--background); text-decoration: none; font-size: 14px;
    border-radius: 0.5rem;
  }
  .skip:focus { top: 0.5rem; }

  /* experience badge (e.g. "YC S25", "NSF, $300K") */
  .badge {
    display: inline-block; font-size: 0.75rem; font-weight: 500; line-height: 1.25rem;
    padding: 0 0.6rem; border-radius: 999px; border: 2px solid var(--foreground);
  }

  /* theme toggle: moon in light, sun in dark */
  .when-dark { display: none; }
  :global(html.dark) .when-light { display: none; }
  :global(html.dark) .when-dark { display: inline; }

  /* email popover: open on hover or after click */
  .email-wrap:hover .email-pop[hidden] { display: block; }
  @media (max-width: 640px) {
    /* the mail button is the leftmost in the row; anchor the popover to its left edge so it stays on screen */
    .email-pop { left: 0; transform: none; }
    .email-arrow { left: 1.6rem; transform: none; }
  }

  /* copy buttons: swap icon / tooltip text while "copied" */
  .copy-done { display: none; }
  .copy-btn[data-done] .copy-idle { display: none; }
  .copy-btn[data-done] .copy-done { display: inline; }
  /* the tooltip is display-toggled (not just faded) so its box never widens the page while hidden */
  .tip { display: none; }
  .copy-btn:hover .tip, .copy-btn:focus-visible .tip, .copy-btn[data-done] .tip { display: block; opacity: 1; }
  .copy-btn[data-done] { background: #16a34a; }

  /* show more projects: until expanded only the first row is visible (1 / 2 / 3 per row, like the
     original's perRow), the rest are display:none. */
  .proj-grid:not(.is-open) > li:nth-child(n + 2) { display: none; }
  @media (min-width: 768px) { .proj-grid:not(.is-open) > li:nth-child(n + 2) { display: flex; } .proj-grid:not(.is-open) > li:nth-child(n + 3) { display: none; } }
  @media (min-width: 1024px) { .proj-grid:not(.is-open) > li:nth-child(n + 3) { display: flex; } .proj-grid:not(.is-open) > li:nth-child(n + 4) { display: none; } }
  .more-open { display: none; }
  [data-more-toggle][aria-expanded='true'] .more-idle { display: none; }
  [data-more-toggle][aria-expanded='true'] .more-open { display: inline-flex; }

  /* ---------- skills collapsible (verbatim behaviour from the original ResumeSection) ---------- */
  .skills-article .skills-trigger { position: relative; margin-bottom: 0; align-items: center; }
  .skills-article .skills-trigger-heading { flex: 1; min-width: 0; position: relative; min-height: 2.75rem; }
  .skills-article .skills-trigger-heading-inner {
    position: absolute; left: 50%; transform: translateX(-50%);
    transition: left 0.9s ease, transform 0.9s ease;
  }
  .skills-article.is-expanded .skills-trigger-heading-inner { left: 0; transform: translateX(0); }
  .skills-article .skills-expand-hint { position: absolute; right: 0; top: 50%; transform: translateY(-50%); }
  .skills-article.is-expanded .skills-trigger { margin-bottom: 1.5rem; }
  .skills-article.is-expanded .skills-expand-hint { position: static; transform: none; display: none; }
  .skills-article .skills-collapse-hint { display: none; }
  .skills-article.is-expanded .skills-collapse-hint { display: flex; margin-left: auto; }
  .skills-article .skills-content {
    display: grid; grid-template-rows: 0fr; opacity: 0;
    transition: grid-template-rows 0.35s ease-out, opacity 0.3s ease-out;
  }
  .skills-article .skills-content > * { min-height: 0; overflow: hidden; }
  .skills-article.is-expanded .skills-content { grid-template-rows: 1fr; opacity: 1; }
  @media (max-width: 480px) {
    /* the centred title and the "Expand" hint collide on narrow phones; stack them */
    .skills-article .skills-trigger-heading-inner { position: static; transform: none; }
    .skills-article .skills-expand-hint { position: static; transform: none; margin-left: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .skills-article .skills-trigger-heading-inner, .skills-article .skills-content { transition: none; }
  }

  @media print {
    :global(.opt-switch), .skip, [data-more-toggle], .skills-expand-hint, .skills-collapse-hint { display: none !important; }
    .proj-grid > li { display: flex !important; }
    .skills-article .skills-content { grid-template-rows: 1fr; opacity: 1; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;

    // Theme toggle — shared contract: html.dark + localStorage.theme (pre-paint init lives in ProLayout).
    var themeBtn = document.querySelector('[data-theme-toggle]');
    function syncTheme() {
      if (themeBtn) themeBtn.setAttribute('aria-label', root.classList.contains('dark') ? 'Switch to light theme' : 'Switch to dark theme');
    }
    syncTheme();
    if (themeBtn) themeBtn.addEventListener('click', function () {
      var dark = root.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      syncTheme();
    });

    // Email popover (hover is CSS; click toggles it open for keyboard/touch).
    var emailBtn = document.querySelector('[data-email-toggle]');
    var pop = document.getElementById('email-pop');
    var wrap = document.querySelector('.email-wrap');
    function setPop(open) {
      if (!pop || !emailBtn) return;
      pop.hidden = !open;
      emailBtn.setAttribute('aria-expanded', String(open));
    }
    if (emailBtn) emailBtn.addEventListener('click', function () { setPop(pop.hidden); });
    document.addEventListener('click', function (e) { if (wrap && !wrap.contains(e.target)) setPop(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setPop(false); });

    // Copy-to-clipboard buttons.
    Array.prototype.forEach.call(document.querySelectorAll('[data-copy]'), function (b) {
      b.addEventListener('click', function (e) {
        e.stopPropagation();
        var email = b.getAttribute('data-copy');
        var done = function () {
          b.setAttribute('data-done', '');
          setTimeout(function () { b.removeAttribute('data-done'); }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).then(done, function () { location.href = 'mailto:' + email; });
        } else {
          location.href = 'mailto:' + email;
        }
      });
    });

    // Technical Skills collapse (remembers state for the session, like the original).
    var KEY = 'resume-skills-expanded';
    var article = document.querySelector('.skills-article');
    var trigger = document.querySelector('.skills-trigger');
    if (article && trigger) {
      var saved = false;
      try { saved = sessionStorage.getItem(KEY) === 'true'; } catch (e) {}
      if (saved) { article.classList.add('is-expanded'); trigger.setAttribute('aria-expanded', 'true'); }
      trigger.addEventListener('click', function () {
        var open = article.classList.toggle('is-expanded');
        trigger.setAttribute('aria-expanded', String(open));
        try { sessionStorage.setItem(KEY, String(open)); } catch (e) {}
      });
    }

    // Show More Projects.
    var moreBtn = document.querySelector('[data-more-toggle]');
    var more = document.getElementById('more-projects');
    if (moreBtn && more) moreBtn.addEventListener('click', function () {
      var open = more.classList.toggle('is-open');
      moreBtn.setAttribute('aria-expanded', String(open));
      if (!open) document.getElementById('projects').scrollIntoView({ block: 'start' });
    });
  })();
</script>
