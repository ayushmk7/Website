---
// src/pages/options/1.astro — Option 1 "Ledger": Swiss editorial, single column.
// One typeface (Inter), one accent, hairline rules, dates in the margin.
// Content comes only from ../../lib/profile (the shared contract), nothing from the raw data files.
import ProLayout from '../../layouts/ProLayout.astro';
import OptionSwitcher from '../../components/OptionSwitcher.astro';
import {
  profile, contactLinks, sections, education,
  experience, hackathons, featuredProjects, moreProjects, visibleProjects,
  skillGroups, stats, FUN_HREF,
} from '../../lib/profile';
import type { Project } from '../../lib/profile';

const isCurrent = (period: string) => /present/i.test(period);
const isWin = (placement: string) => /1st|winner/i.test(placement);
const primaryUrl = (p: Project) => p.githubUrl ?? p.websiteUrl;
const skillTotal = skillGroups.reduce((n, g) => n + g.all.length, 0);
const year = new Date().getFullYear();

const counts: Record<string, string> = {
  experience: `${stats.roles} roles`,
  projects: `${visibleProjects.length} projects`,
  hackathons: `${stats.hackathonPlacements} placements · ${stats.hackathonWins} wins`,
  skills: `${skillTotal} skills`,
  education: `Class of ${stats.graduation.split(' ').pop()}`,
  contact: profile.location,
};
const sectionLabel = Object.fromEntries(sections.map((s) => [s.id, s.label]));
---
<ProLayout title={`${profile.name} — ${profile.headline}`} bodyClass="ledger">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
  </Fragment>

  <a class="skip" href="#main">Skip to content</a>

  <header class="bar" id="top">
    <div class="bar__in">
      <a class="bar__name" href="#top">
        <span class="bar__name--full">{profile.name}</span>
        <span class="bar__name--short" aria-hidden="true">{profile.initials}</span>
      </a>
      <nav class="bar__nav" aria-label="Sections">
        <ul class="bar__links">
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
        </ul>
        <details class="menu">
          <summary aria-label="Open section menu">Menu</summary>
          <ul class="menu__list">
            {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
          </ul>
        </details>
      </nav>
      <a class="bar__fun" href={FUN_HREF} title="Switch to the comic version of this site">Fun mode <span aria-hidden="true">↗</span></a>
      <button class="bar__theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
        <span class="when-light">Dark</span><span class="when-dark">Light</span>
      </button>
    </div>
  </header>

  <main class="page" id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-name">
      <h1 id="hero-name">{profile.name}</h1>
      <p class="hero__headline">{profile.headline} · {profile.location}</p>
      <p class="hero__summary">{profile.summary}</p>
      <ul class="links" aria-label="Contact links">
        {contactLinks.map((l) => (
          <li>
            {l.external
              ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}{l.key === 'resume' ? ' (PDF)' : ''}</a>
              : <a href={l.href}>{l.label}</a>}
            {l.key === 'email' && (
              <button type="button" class="copy" data-copy={profile.email} aria-label={`Copy email address ${profile.email}`}>Copy</button>
            )}
          </li>
        ))}
      </ul>
    </section>

    <!-- Experience -->
    <section id="experience" aria-labelledby="h-experience">
      <div class="sec__head">
        <h2 id="h-experience">{sectionLabel.experience}</h2>
        <span class="sec__count">{counts.experience}</span>
      </div>
      <ul class="entries">
        {experience.map((e) => (
          <li class="row">
            <div class="row__aside">
              <span class="meta">
                {isCurrent(e.period) && <span class="dot" title="Current role"></span>}
                {e.period}
              </span>
              {e.location && <span class="meta meta--muted">{e.location}</span>}
            </div>
            <div class="row__body">
              <h3>
                {e.role}
                <span class="h3__sep" aria-hidden="true"> — </span>
                {e.url
                  ? <a href={e.url} target="_blank" rel="noopener noreferrer">{e.company}</a>
                  : <span class="h3__company">{e.company}</span>}
              </h3>
              <p class="tags">
                {e.badge && <span class="pill">{e.badge}</span>}
                <span class="muted">{e.kind}</span>
              </p>
              <ul class="bullets">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Projects -->
    <section id="projects" aria-labelledby="h-projects">
      <div class="sec__head">
        <h2 id="h-projects">{sectionLabel.projects}</h2>
        <span class="sec__count">{counts.projects}</span>
      </div>
      <ul class="entries">
        {featuredProjects.map((p) => (
          <li class="row">
            <div class="row__aside">
              {p.tags.slice(0, 2).map((t) => <span class="meta meta--muted">{t}</span>)}
            </div>
            <div class="row__body">
              <h3 class="h3--inline">
                <span>{p.title}</span>
                <span class="h3__links">
                  {p.githubUrl && <a href={p.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>}
                  {p.websiteUrl && <a href={p.websiteUrl} target="_blank" rel="noopener noreferrer">Site</a>}
                </span>
              </h3>
              <p class="desc">{p.description}</p>
            </div>
          </li>
        ))}
      </ul>
      <details class="more">
        <summary>Show {moreProjects.length} more projects</summary>
        <ul class="compact">
          {moreProjects.map((p) => (
            <li>
              <h3 class="compact__title">
                {primaryUrl(p)
                  ? <a href={primaryUrl(p)} target="_blank" rel="noopener noreferrer">{p.title}</a>
                  : p.title}
                {p.githubUrl && p.websiteUrl && (
                  <a class="compact__alt" href={p.websiteUrl} target="_blank" rel="noopener noreferrer">Site</a>
                )}
              </h3>
              <p class="compact__desc">{p.description}</p>
              <p class="compact__tags">{p.tags.join(' · ')}</p>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <!-- Hackathons -->
    <section id="hackathons" aria-labelledby="h-hackathons">
      <div class="sec__head">
        <h2 id="h-hackathons">{sectionLabel.hackathons}</h2>
        <span class="sec__count">{counts.hackathons}</span>
      </div>
      <ol class="entries">
        {hackathons.map((h) => (
          <li class="row">
            <div class="row__aside">
              <span class="meta">{h.date}</span>
              <span class="meta meta--muted">{h.organizer}</span>
            </div>
            <div class="row__body">
              <h3>{h.event}</h3>
              <p class="placement">
                {isWin(h.placement) && <span class="dot" title="Win"></span>}
                <strong>{h.placement}</strong>{h.prize && <span class="muted"> · {h.prize}</span>}
              </p>
              <p class="tags"><span class="pill">{h.project}</span></p>
              <p class="desc">{h.blurb}</p>
              {(h.repoUrl || h.siteUrl) && (
                <p class="row__links">
                  {h.repoUrl && <a href={h.repoUrl} target="_blank" rel="noopener noreferrer">Repository</a>}
                  {h.siteUrl && <a href={h.siteUrl} target="_blank" rel="noopener noreferrer">Site</a>}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Skills -->
    <section id="skills" aria-labelledby="h-skills">
      <div class="sec__head">
        <h2 id="h-skills">{sectionLabel.skills}</h2>
        <span class="sec__count">{counts.skills}</span>
      </div>
      <ul class="entries entries--tight">
        {skillGroups.map((g) => (
          <li class="row row--tight">
            <div class="row__aside"><h3 class="meta meta--muted">{g.shortLabel}</h3></div>
            <div class="row__body"><p class="skills__line">{g.featured.join(' · ')}</p></div>
          </li>
        ))}
      </ul>
      <details class="more">
        <summary>Full list ({skillTotal})</summary>
        <ul class="compact">
          {skillGroups.map((g) => (
            <li>
              <p class="compact__title">{g.label}</p>
              <p class="compact__desc">{g.all.join(', ')}</p>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <!-- Education -->
    <section id="education" aria-labelledby="h-education">
      <div class="sec__head">
        <h2 id="h-education">{sectionLabel.education}</h2>
        <span class="sec__count">{counts.education}</span>
      </div>
      <ul class="entries">
        {education.map((ed) => (
          <li class="row">
            <div class="row__aside">
              <span class="meta">{ed.period}</span>
              <span class="meta meta--muted">{ed.location}</span>
            </div>
            <div class="row__body">
              <h3>{ed.degree}</h3>
              <p class="desc">
                {ed.url
                  ? <a href={ed.url} target="_blank" rel="noopener noreferrer">{ed.institution}</a>
                  : ed.institution}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Contact -->
    <section id="contact" aria-labelledby="h-contact">
      <div class="sec__head">
        <h2 id="h-contact">{sectionLabel.contact}</h2>
        <span class="sec__count">{counts.contact}</span>
      </div>
      <p class="desc">{profile.availability}</p>
      <p class="contact__email">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <button type="button" class="copy" data-copy={profile.email} aria-label={`Copy email address ${profile.email}`}>Copy</button>
      </p>
      <ul class="links" aria-label="Contact links">
        {contactLinks.map((l) => (
          <li>
            {l.external
              ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}{l.key === 'resume' ? ' (PDF)' : ''}</a>
              : <a href={l.href}>{l.label}</a>}
          </li>
        ))}
      </ul>
    </section>

    <footer class="foot">
      <p>© {year} {profile.name} · <a class="accent" href={FUN_HREF}>Fun mode</a> · <a href="#top">Top</a></p>
    </footer>
  </main>

  <OptionSwitcher />
</ProLayout>

<style>
  /* ---------- tokens ---------- */
  :global(body.ledger) {
    --bg: #ffffff;
    --fg: #111111;
    --muted: #6b6b6b;
    --rule: #e5e5e5;
    --accent: #d62828;
    --chip-bg: #f4f4f4;
    --bar-h: 48px;
    color-scheme: light;
    background: var(--bg);
    color: var(--fg);
    margin: 0;
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-feature-settings: 'ss01', 'cv11', 'tnum';
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  :global(html.dark body.ledger) {
    --bg: #0f0f0f;
    --fg: #ededed;
    --muted: #9a9a9a;
    --rule: #262626;
    --accent: #ff5c5c;
    --chip-bg: #1c1c1c;
    color-scheme: dark;
  }
  :global(html) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }

  /* ---------- base ---------- */
  a { color: inherit; text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  a:hover { text-decoration-color: var(--accent); }
  a:focus-visible, button:focus-visible, summary:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
    border-radius: 2px;
  }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  p { margin: 0; }
  ul, ol { list-style: none; margin: 0; padding: 0; }
  h1, h2, h3 { margin: 0; font-weight: 600; }
  .accent { color: var(--accent); text-decoration-color: currentColor; }
  .muted { color: var(--muted); }

  .skip {
    position: absolute; left: 1rem; top: -3rem; z-index: 10;
    padding: 0.4rem 0.7rem; background: var(--fg); color: var(--bg); text-decoration: none; font-size: 14px;
  }
  .skip:focus { top: 0.5rem; }

  /* ---------- top bar ---------- */
  .bar {
    position: sticky; top: 0; z-index: 5;
    height: var(--bar-h);
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .bar__in {
    max-width: 44rem; height: 100%; margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 2rem);
    display: flex; align-items: center; gap: 1.1rem;
    font-size: 14px;
  }
  .bar__name { font-weight: 600; text-decoration: none; white-space: nowrap; margin-right: auto; letter-spacing: -0.01em; }
  .bar__name--short { display: none; }
  .bar__links { display: flex; gap: 1rem; }
  .bar__links a { text-decoration: none; color: var(--muted); }
  .bar__links a:hover { color: var(--fg); text-decoration: underline; text-decoration-color: var(--accent); }
  .bar__fun { color: var(--accent); text-decoration: none; white-space: nowrap; font-weight: 500; }
  .bar__fun:hover { text-decoration: underline; }
  .bar__theme { color: var(--muted); min-height: 40px; padding: 0 0.1rem; }
  .bar__theme:hover { color: var(--fg); }
  .when-dark { display: none; }
  :global(html.dark) .when-light { display: none; }
  :global(html.dark) .when-dark { display: inline; }

  /* mobile menu (details) */
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; color: var(--muted); min-height: 40px; display: inline-flex; align-items: center; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { color: var(--fg); }
  .menu__list {
    position: absolute; right: -0.5rem; top: calc(100% + 4px); min-width: 11rem;
    background: var(--bg); border: 1px solid var(--rule); padding: 0.4rem 0;
  }
  .menu__list a { display: block; padding: 0.55rem 1rem; text-decoration: none; }
  .menu__list a:hover { background: var(--chip-bg); }

  @media (max-width: 639px) {
    .bar__links { display: none; }
    .menu { display: block; }
  }
  @media (max-width: 479px) {
    .bar__name--full { display: none; }
    .bar__name--short { display: inline; }
    .bar__in { gap: 0.9rem; }
  }

  /* ---------- page ---------- */
  .page {
    max-width: 44rem; margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 2rem) 3rem;
  }
  section { padding: 4rem 0; border-top: 1px solid var(--rule); scroll-margin-top: calc(var(--bar-h) + 1rem); }
  section.hero { border-top: 0; padding-top: clamp(3rem, 8vw, 5rem); }

  h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.05; letter-spacing: -0.02em; }
  h2 { font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg); }
  h3 { font-size: 19px; line-height: 1.35; }
  h3 a { text-decoration-color: var(--rule); }

  .hero__headline { margin-top: 0.9rem; color: var(--muted); font-size: 17px; }
  .hero__summary { margin-top: 1.75rem; font-size: 19px; line-height: 1.55; max-width: 68ch; }

  .links { display: flex; flex-wrap: wrap; gap: 0.25rem 0; margin-top: 1.5rem; font-size: 15px; }
  .links li { display: inline-flex; align-items: center; min-height: 40px; }
  .links li + li::before { content: '·'; color: var(--muted); margin: 0 0.6rem; }

  .copy {
    margin-left: 0.45rem; font-size: 12px; color: var(--muted);
    border: 1px solid var(--rule); border-radius: 999px; padding: 0.1rem 0.5rem; line-height: 1.5;
    min-height: 24px;
  }
  .copy:hover { color: var(--fg); border-color: var(--muted); }
  .copy[data-done] { color: var(--accent); border-color: var(--accent); }

  .sec__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  .sec__count { display: none; color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
  @media (min-width: 768px) { .sec__count { display: inline; } }

  /* entry rows: dates in the margin */
  .entries > li + li { margin-top: 2.5rem; }
  .entries--tight > li + li { margin-top: 0.9rem; }
  .row { display: grid; grid-template-columns: 1fr; gap: 0.5rem 1.5rem; }
  @media (min-width: 640px) {
    .row { grid-template-columns: 10rem minmax(0, 1fr); }
    .row__aside { padding-top: 0.25rem; }
    .row--tight .row__aside { padding-top: 0; }
  }
  .row__aside { display: flex; flex-direction: column; gap: 0.15rem; }
  @media (max-width: 639px) {
    .row__aside { flex-direction: row; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
  }
  .row__body { min-width: 0; }
  .meta { font-size: 13px; line-height: 1.5; font-variant-numeric: tabular-nums; font-weight: 400; }
  .meta--muted { color: var(--muted); }
  .dot {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); margin-right: 0.45rem; vertical-align: 0.05em;
  }
  .h3__company { font-weight: 500; }
  .h3--inline { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; }
  .h3__links { font-size: 13px; font-weight: 400; display: inline-flex; gap: 0.6rem; }
  .h3__links a, .row__links a { color: var(--muted); }
  .h3__links a:hover, .row__links a:hover { color: var(--fg); }

  .tags { margin-top: 0.45rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 13px; }
  .pill {
    display: inline-block; border: 1px solid var(--rule); border-radius: 999px;
    padding: 0.05rem 0.55rem; font-size: 12px; line-height: 1.6; font-weight: 500; color: var(--fg);
    background: var(--chip-bg);
  }
  .bullets { margin-top: 0.85rem; }
  .bullets li { position: relative; padding-left: 1.1rem; font-size: 16px; }
  .bullets li + li { margin-top: 0.45rem; }
  .bullets li::before { content: '–'; position: absolute; left: 0; color: var(--muted); }

  .desc { margin-top: 0.5rem; font-size: 16px; max-width: 68ch; }
  .placement { margin-top: 0.35rem; font-size: 16px; }
  .row__links { margin-top: 0.5rem; font-size: 13px; display: flex; gap: 0.8rem; }
  .skills__line { font-size: 15px; line-height: 1.6; }

  /* disclosures */
  .more { margin-top: 2.25rem; border-top: 1px solid var(--rule); }
  .more summary {
    list-style: none; cursor: pointer; padding: 0.9rem 0; font-size: 15px; font-weight: 500;
    display: flex; align-items: center; gap: 0.6rem; min-height: 44px;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: '+'; color: var(--muted); font-weight: 400; width: 1ch; }
  .more[open] summary::before { content: '–'; }
  .more summary:hover { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
  .compact { padding-bottom: 0.5rem; }
  .compact > li { padding: 0.9rem 0; border-top: 1px solid var(--rule); }
  .compact__title { font-size: 16px; font-weight: 600; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem; }
  .compact__alt { font-size: 13px; font-weight: 400; color: var(--muted); }
  .compact__desc { margin-top: 0.2rem; font-size: 15px; color: var(--fg); max-width: 68ch; }
  .compact__tags { margin-top: 0.3rem; font-size: 13px; color: var(--muted); }

  .contact__email { margin-top: 1rem; font-size: 19px; font-weight: 600; display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; overflow-wrap: anywhere; }
  .contact__email a { text-decoration-color: var(--rule); }
  .contact__email a:hover { text-decoration-color: var(--accent); }

  .foot { padding-top: 2rem; border-top: 1px solid var(--rule); font-size: 13px; color: var(--muted); }
  .foot a { color: var(--muted); }
  .foot a.accent { color: var(--accent); }
  .foot a:hover { color: var(--fg); }

  @media print {
    .bar, .foot, .copy, :global(.opt-switch) { display: none !important; }
    section { padding: 1.5rem 0; }
    .sec__count { display: inline; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.querySelector('[data-theme-toggle]');
    function syncLabel() {
      if (btn) btn.setAttribute('aria-label', root.classList.contains('dark') ? 'Switch to light theme' : 'Switch to dark theme');
    }
    syncLabel();
    if (btn) btn.addEventListener('click', function () {
      var dark = root.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      syncLabel();
    });

    var copies = document.querySelectorAll('[data-copy]');
    Array.prototype.forEach.call(copies, function (b) {
      b.addEventListener('click', function () {
        var email = b.getAttribute('data-copy');
        var done = function () {
          b.textContent = 'Copied';
          b.setAttribute('data-done', '');
          setTimeout(function () { b.textContent = 'Copy'; b.removeAttribute('data-done'); }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).then(done, function () { location.href = 'mailto:' + email; });
        } else {
          location.href = 'mailto:' + email;
        }
      });
    });

    var menu = document.querySelector('.menu');
    if (menu) {
      menu.addEventListener('click', function (e) {
        if (e.target && e.target.tagName === 'A') menu.removeAttribute('open');
      });
      document.addEventListener('click', function (e) {
        if (menu.hasAttribute('open') && !menu.contains(e.target)) menu.removeAttribute('open');
      });
    }
  })();
</script>
