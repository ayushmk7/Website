---
// src/pages/options/5.astro — Option 5 "Original, refined".
// Option 4's identity (white/black/blue, minimal, the blue hero bar, thick bordered cards, mono tag pills)
// after three reviews, merged:
//  - Recruiter: a fact-only hero (school, degree, expected graduation, location, availability, current
//    roles, hackathon record) with the résumé PDF as the one filled primary action; JSON-LD Person.
//  - UI/UX: sticky section nav, one border level (entries are rules, not boxes), dates in a left rail,
//    one type scale, labelled controls (no icon-only buttons), ~88svh hero, 44px touch targets.
//  - Engineer: sections in profile order, all four featured projects visible, capped tag lists,
//    "Project at Event" hackathon headings, native <details> for everything hidden (works without JS),
//    <main>/<section> landmarks, strict H1 → H2 → H3, print opens every disclosure.
// No summary paragraph in the hero (the user removed it from the original). Content only from profile.
import ProLayout from '../../layouts/ProLayout.astro';
import OptionSwitcher from '../../components/OptionSwitcher.astro';
import Icon from '../../components/pro/opt5/Icon.astro';
import {
  profile, contactLinks, sections, education, experience, hackathonsWithProject,
  featuredProjects, moreProjects, skillGroups, stats, FUN_HREF,
} from '../../lib/profile';

const byKey = Object.fromEntries(contactLinks.map((l) => [l.key, l]));
const heroLinks = [byKey.email, byKey.github, byKey.linkedin];
const iconFor: Record<string, 'mail' | 'github' | 'linkedin' | 'x' | 'file'> = { email: 'mail', github: 'github', linkedin: 'linkedin', x: 'x', resume: 'file' };

// Recruiter facts, all derived from profile (no new claims).
const edu = education[0];
const availabilityShort = profile.availability.split('.')[0].trim();
const hackRecord = `${stats.hackathonPlacements} hackathon placements, ${stats.hackathonWins} first-place or track wins`;
const totalSkills = skillGroups.reduce((n, g) => n + g.all.length, 0);

// Data mixes "May 2026 to Present" with "Aug 2025 – Dec 2028": render one style.
const fmtPeriod = (s: string) => s.replace(/\s+to\s+/g, ' – ');
// A 12-pill card is half tags: show the first N, count the rest (full list in the title).
const capTags = (tags: string[], max: number) => ({ shown: tags.slice(0, max), rest: tags.slice(max) });

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: profile.site,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  alumniOf: edu ? { '@type': 'CollegeOrUniversity', name: edu.institution, url: edu.url } : undefined,
  sameAs: contactLinks.filter((l) => ['github', 'linkedin', 'x'].includes(l.key)).map((l) => l.href),
});

// Shared class strings.
const pill = 'inline-flex items-center justify-center gap-2 min-h-[44px] px-5 rounded-2xl border-2 border-foreground bg-background text-base font-medium hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-colors duration-150';
const pillPrimary = 'inline-flex items-center justify-center gap-2 min-h-[44px] px-5 rounded-2xl border-2 border-blue-600 bg-blue-600 text-white text-base font-medium hover:bg-blue-700 hover:border-blue-700 transition-colors duration-150';
const card = 'card w-full bg-background border-4 border-foreground rounded-3xl p-5 sm:p-6 md:p-8';
const projectCard = 'border-2 border-foreground rounded-2xl p-5 flex flex-col gap-3 bg-background hover:border-blue-600 dark:hover:border-blue-500 transition-colors duration-150';
const monoTag = 'px-2.5 py-0.5 text-[13px] leading-5 rounded-full border border-foreground bg-background font-mono';
const textLink = 'inline-flex items-center gap-1.5 min-h-[40px] px-3 rounded-lg border-2 border-foreground bg-background text-sm font-medium hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-colors duration-150';
const blue = 'text-blue-600 dark:text-blue-400';
const muted = 'text-muted-foreground';
const iconBox = 'inline-flex p-2 bg-blue-600 rounded-lg shrink-0 text-white';
---
<ProLayout title={`${profile.name} — ${profile.headline}`} bodyClass="opt5">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <a class="skip" href="#main">Skip to content</a>
  <noscript><style>[data-theme-toggle], [data-copy] { display: none !important; }</style></noscript>

  <!-- Sticky section nav: where am I, jump to, résumé, theme. -->
  <header class="site-nav sticky top-0 z-40 bg-background border-b-2 border-foreground">
    <div class="max-w-6xl mx-auto px-4 md:px-6 h-14 flex items-center gap-3">
      <a href="#top" class="nav-brand font-semibold tracking-tight text-base shrink-0 min-h-[44px] items-center pr-2" aria-label={`${profile.name}, back to top`}>{profile.initials}</a>
      <nav class="site-nav-links flex-1 min-w-0" aria-label="Sections">
        <ul class="flex items-center gap-1 overflow-x-auto whitespace-nowrap">
          {sections.map((s) => (
            <li><a href={`#${s.id}`} class="nav-link" data-nav={s.id}>{s.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="flex items-center gap-1 shrink-0">
        <a href={profile.resumeHref} target="_blank" rel="noopener noreferrer" class="nav-link nav-resume">Résumé <span aria-hidden="true">↗</span></a>
        <button type="button" class="nav-icon" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
          <span class="when-light"><Icon name="moon" class="w-5 h-5" /></span>
          <span class="when-dark"><Icon name="sun" class="w-5 h-5" /></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero: facts a recruiter checks in the first screen, no prose. -->
  <section id="top" class="hero flex flex-col justify-center items-center px-4 md:px-8 pt-14 pb-12 md:pt-20 md:pb-16" aria-labelledby="hero-name">
    <div class="max-w-3xl mx-auto text-center">
      <div class="w-32 h-3 bg-blue-600 rounded-full mx-auto mb-6" aria-hidden="true"></div>
      <h1 id="hero-name" class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight leading-[1.05] mb-3 text-foreground">{profile.name}</h1>
      <p class="text-lg md:text-xl font-medium mb-1">{profile.headline}</p>
      {edu && (
        <p class={`text-sm md:text-base ${muted} mb-4`}>
          <span>{edu.degree}</span><span aria-hidden="true"> · </span><span class="whitespace-nowrap">Expected {stats.graduation}</span><span aria-hidden="true"> · </span><span class="whitespace-nowrap">{profile.location}</span>
        </p>
      )}
      <p class={`text-base md:text-lg font-mono ${blue} mb-5`}>{profile.tagline}</p>

      <p class="mb-6">
        <span class="avail inline-flex items-center gap-2 px-4 py-1.5 rounded-full border-2 font-medium text-sm md:text-base">
          <span class="avail-dot w-2 h-2 rounded-full" aria-hidden="true"></span>{availabilityShort}
        </span>
      </p>

      {stats.currentRoles.length > 0 && (
        <div class="mb-3">
          <p class={`text-xs uppercase tracking-widest font-medium ${muted} mb-1.5`}>Now</p>
          <ul class="now flex flex-wrap justify-center gap-x-5 gap-y-1.5">
            {stats.currentRoles.map((r) => (
              <li>
                <span class="font-semibold">{r.url ? <a href={r.url} target="_blank" rel="noopener noreferrer" class="entry-link">{r.company}</a> : r.company}</span>
                {r.badge && <span class="badge ml-1.5 align-middle">{r.badge}</span>}
                <span class={muted}> · {r.role}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      <p class={`text-sm ${muted} mb-8`}><a href="#hackathons" class="entry-link">{hackRecord}</a></p>

      <div class="flex justify-center gap-3 flex-wrap" role="group" aria-label="Résumé and contact">
        <a href={profile.resumeHref} target="_blank" rel="noopener noreferrer" class={pillPrimary}>
          <Icon name="file" class="w-5 h-5" /> Résumé (PDF)
        </a>
        {heroLinks.map((l) => (
          <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined} class={pill}>
            <Icon name={iconFor[l.key]} class="w-5 h-5" /> {l.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <main id="main" class="max-w-6xl mx-auto px-4 md:px-6 pb-8 space-y-8 md:space-y-10" tabindex="-1">
    <!-- Experience -->
    <section id="experience" class={card} aria-labelledby="experience-heading">
      <div class="card-head">
        <div class="flex items-center gap-3">
          <span class={iconBox} aria-hidden="true"><Icon name="briefcase" class="h-5 w-5" /></span>
          <h2 id="experience-heading" class="section-title">Experience</h2>
        </div>
        <p class={`text-sm ${muted}`}>{stats.currentRoles.length} current roles · most recent first</p>
      </div>
      <ol class="entries">
        {experience.map((job) => (
          <li class="entry">
            <div class="entry-rail">
              <span>{fmtPeriod(job.period)}</span>
              {job.location && <span>{job.location}</span>}
            </div>
            <div class="min-w-0">
              <h3 class="entry-title">
                {job.url
                  ? <a href={job.url} target="_blank" rel="noopener noreferrer" class="entry-link">{job.company}<span class="sr-only"> (opens in a new tab)</span></a>
                  : job.company}
                {job.badge && <span class="badge">{job.badge}</span>}
                {job.kind !== 'Work' && <span class="badge badge-kind">{job.kind}</span>}
              </h3>
              <p class={`font-medium ${blue}`}>{job.role}</p>
              <ul class="bullets">
                {job.bullets.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Projects: the four featured always visible; the rest behind a native disclosure. -->
    <section id="projects" class={card} aria-labelledby="projects-heading">
      <div class="card-head">
        <div class="flex items-center gap-3">
          <span class={iconBox} aria-hidden="true"><Icon name="code" class="h-5 w-5" /></span>
          <h2 id="projects-heading" class="section-title">Projects</h2>
        </div>
        <p class={`text-sm ${muted}`}>{featuredProjects.length + moreProjects.length} projects · hackathon builds are listed below</p>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5" aria-label="Featured projects">
        {featuredProjects.map((p) => {
          const { shown, rest } = capTags(p.tags, 6);
          return (
            <li class={projectCard}>
              <h3 class="text-lg font-semibold leading-snug">{p.title}</h3>
              <p class="text-[15px] leading-relaxed flex-grow">{p.description}</p>
              <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
                {shown.map((tag) => <li class={monoTag}>{tag}</li>)}
                {rest.length > 0 && <li class={`${monoTag} ${muted}`} title={rest.join(', ')}>+{rest.length}</li>}
              </ul>
              {(p.githubUrl || p.websiteUrl) && (
                <div class="flex flex-wrap gap-2">
                  {p.githubUrl && <a href={p.githubUrl} target="_blank" rel="noopener noreferrer" class={textLink}><Icon name="github" class="w-4 h-4" /> Code<span class="sr-only">: {p.title} on GitHub</span></a>}
                  {p.websiteUrl && <a href={p.websiteUrl} target="_blank" rel="noopener noreferrer" class={textLink}><Icon name="external" class="w-4 h-4" /> Live<span class="sr-only">: {p.title} website</span></a>}
                </div>
              )}
            </li>
          );
        })}
      </ul>

      {moreProjects.length > 0 && (
        <details class="more mt-6">
          <summary class="flex justify-center cursor-pointer list-none">
            <span class={pill}>
              <span class="more-idle inline-flex items-center gap-2">Show {moreProjects.length} more projects <Icon name="chevron-down" class="w-5 h-5" /></span>
              <span class="more-open inline-flex items-center gap-2">Show fewer projects <Icon name="chevron-up" class="w-5 h-5" /></span>
            </span>
          </summary>
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5 mt-6" aria-label="More projects">
            {moreProjects.map((p) => {
              const { shown, rest } = capTags(p.tags, 4);
              return (
                <li class={projectCard}>
                  <h3 class="text-base font-semibold leading-snug">{p.title}</h3>
                  <p class="text-sm leading-relaxed flex-grow">{p.description}</p>
                  <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
                    {shown.map((tag) => <li class={`${monoTag} text-xs`}>{tag}</li>)}
                    {rest.length > 0 && <li class={`${monoTag} text-xs ${muted}`} title={rest.join(', ')}>+{rest.length}</li>}
                  </ul>
                  {(p.githubUrl || p.websiteUrl) && (
                    <div class="flex flex-wrap gap-2">
                      {p.githubUrl && <a href={p.githubUrl} target="_blank" rel="noopener noreferrer" class={textLink}><Icon name="github" class="w-4 h-4" /> Code<span class="sr-only">: {p.title} on GitHub</span></a>}
                      {p.websiteUrl && <a href={p.websiteUrl} target="_blank" rel="noopener noreferrer" class={textLink}><Icon name="external" class="w-4 h-4" /> Live<span class="sr-only">: {p.title} website</span></a>}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </details>
      )}
    </section>

    <!-- Hackathons: lead with the project, the event is context. -->
    <section id="hackathons" class={card} aria-labelledby="hackathons-heading">
      <div class="card-head">
        <div class="flex items-center gap-3">
          <span class={iconBox} aria-hidden="true"><Icon name="trophy" class="h-5 w-5" /></span>
          <h2 id="hackathons-heading" class="section-title">Hackathons</h2>
        </div>
        <p class={`text-sm ${muted}`}>{stats.hackathonPlacements} placements · {stats.hackathonWins} first-place or track wins</p>
      </div>
      <ol class="entries">
        {hackathonsWithProject.map((h) => {
          const { shown, rest } = capTags(h.projectEntry?.tags ?? [], 6);
          return (
            <li class="entry">
              <div class="entry-rail">
                <span>{h.date}</span>
                <span>{h.organizer}</span>
              </div>
              <div class="min-w-0">
                <h3 class="entry-title">{h.project} <span class={`font-normal ${muted}`}>at</span> {h.event}</h3>
                <p class={`font-medium ${blue}`}>{h.placement}{h.prize && h.prize !== 'Cash prize' && <span class={`font-normal ${muted}`}> · {h.prize}</span>}</p>
                <p class="mt-2 leading-relaxed max-w-[72ch]">{h.blurb}</p>
                {shown.length > 0 && (
                  <ul class="flex flex-wrap gap-1.5 mt-3" aria-label="Stack">
                    {shown.map((tag) => <li class={monoTag}>{tag}</li>)}
                    {rest.length > 0 && <li class={`${monoTag} ${muted}`} title={rest.join(', ')}>+{rest.length}</li>}
                  </ul>
                )}
                {(h.repoUrl || h.siteUrl) && (
                  <div class="flex flex-wrap gap-2 mt-3">
                    {h.repoUrl && <a href={h.repoUrl} target="_blank" rel="noopener noreferrer" class={textLink}><Icon name="github" class="w-4 h-4" /> Code<span class="sr-only">: {h.project} on GitHub</span></a>}
                    {h.siteUrl && <a href={h.siteUrl} target="_blank" rel="noopener noreferrer" class={textLink}><Icon name="external" class="w-4 h-4" /> Live<span class="sr-only">: {h.project} website</span></a>}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <!-- Skills: curated picks visible; the rest per category behind a native disclosure. -->
    <section id="skills" class={card} aria-labelledby="skills-heading">
      <div class="card-head">
        <div class="flex items-center gap-3">
          <span class={iconBox} aria-hidden="true"><Icon name="sparkles" class="h-5 w-5" /></span>
          <h2 id="skills-heading" class="section-title">Skills</h2>
        </div>
        <p class={`text-sm ${muted}`}>{totalSkills} skills across {skillGroups.length} areas</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
        {skillGroups.map((g) => {
          const extra = g.all.filter((s) => !g.featured.includes(s));
          return (
            <div>
              <h3 class="text-base font-semibold mb-2">{g.label}</h3>
              <ul class="flex flex-wrap gap-1.5" aria-label={g.label}>
                {g.featured.map((s) => <li class="skill">{s}</li>)}
              </ul>
              {extra.length > 0 && (
                <details class="more skill-more-wrap mt-2">
                  <summary class="skill skill-more list-none">
                    <span class="more-idle">+{extra.length} more</span><span class="more-open">Show fewer</span>
                  </summary>
                  <ul class="flex flex-wrap gap-1.5 mt-2" aria-label={`${g.label}: more`}>
                    {extra.map((s) => <li class="skill skill-extra">{s}</li>)}
                  </ul>
                </details>
              )}
            </div>
          );
        })}
      </div>
    </section>

    <!-- Education -->
    <section id="education" class={card} aria-labelledby="education-heading">
      <div class="card-head">
        <div class="flex items-center gap-3">
          <span class={iconBox} aria-hidden="true"><Icon name="graduation" class="h-5 w-5" /></span>
          <h2 id="education-heading" class="section-title">Education</h2>
        </div>
      </div>
      <ol class="entries">
        {education.map((ed) => (
          <li class="entry">
            <div class="entry-rail">
              <span>{fmtPeriod(ed.period)}</span>
              {ed.location && <span>{ed.location}</span>}
            </div>
            <div class="min-w-0">
              <h3 class="entry-title">
                {ed.url
                  ? <a href={ed.url} target="_blank" rel="noopener noreferrer" class="entry-link">{ed.institution}<span class="sr-only"> (opens in a new tab)</span></a>
                  : ed.institution}
              </h3>
              <p class={`font-medium ${blue}`}>{ed.degree}</p>
              <p class={`text-sm ${muted} mt-1`}>Graduation expected {stats.graduation}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </main>

  <!-- Contact -->
  <footer id="contact" class="max-w-6xl mx-auto px-4 md:px-6 pt-8 pb-16 text-center" aria-labelledby="contact-heading">
    <div class="w-16 h-1 bg-blue-600 rounded-full mx-auto mb-5" aria-hidden="true"></div>
    <h2 id="contact-heading" class="section-title mb-2">Contact</h2>
    <p class={`${muted} mb-5`}>{profile.availability}</p>
    <p class="flex flex-wrap items-center justify-center gap-2 mb-6">
      <a href={`mailto:${profile.email}`} class="text-lg md:text-xl font-medium underline decoration-2 underline-offset-4 hover:text-blue-600 dark:hover:text-blue-400 break-all min-h-[44px] inline-flex items-center px-1">{profile.email}</a>
      <button type="button" class="copy-btn inline-flex items-center gap-2 min-h-[44px] px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors duration-150" data-copy={profile.email} hidden>
        <span class="copy-idle inline-flex items-center gap-2"><Icon name="copy" class="w-4 h-4" /> Copy</span>
        <span class="copy-done inline-flex items-center gap-2"><Icon name="check" class="w-4 h-4" /> Copied</span>
      </button>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </p>
    <ul class="flex flex-wrap justify-center gap-2 mb-6" aria-label="Profiles">
      {contactLinks.filter((l) => l.key !== 'email').map((l) => (
        <li><a href={l.href} target="_blank" rel="noopener noreferrer" class={textLink}><Icon name={iconFor[l.key]} class="w-4 h-4" /> {l.label}{l.key === 'resume' ? ' (PDF)' : ''}</a></li>
      ))}
    </ul>
    <p>
      <a class={`${blue} text-sm underline decoration-2 underline-offset-4 hover:no-underline`} href={FUN_HREF} title="Switch to the comic version of this site">Fun mode ↗</a>
    </p>
  </footer>

  <OptionSwitcher />
</ProLayout>

<style>
  /* ---------- tokens: the original global.css :root / .dark palette, scoped to this page ---------- */
  :global(body.opt5) {
    --background: #ffffff;
    --foreground: oklch(0.145 0 0);
    --muted-foreground: #62626f; /* 5.9:1 on white */
    --border: rgba(0, 0, 0, 0.1);
    --radius: 0.625rem;
    color-scheme: light;
    margin: 0;
    min-height: 100vh;
    background: var(--background);
    color: var(--foreground);
  }
  :global(html.dark body.opt5) {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --muted-foreground: oklch(0.75 0 0);
    --border: oklch(0.269 0 0);
    color-scheme: dark;
  }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 4.5rem; }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
  :global(body.opt5 :is(section, footer)[id]) { scroll-margin-top: 4.5rem; }

  /* focus: blue ring, visible against black borders in both themes */
  :global(body.opt5 :is(a, button, summary, [tabindex]):focus-visible) { outline: 3px solid #2563eb; outline-offset: 2px; }
  :global(html.dark body.opt5 :is(a, button, summary, [tabindex]):focus-visible) { outline-color: #60a5fa; }
  :global(body.opt5 main:focus) { outline: none; }

  .skip {
    position: absolute; left: 1rem; top: -3rem; z-index: 60;
    padding: 0.5rem 0.8rem; background: var(--foreground); color: var(--background); text-decoration: none; font-size: 14px;
    border-radius: 0.5rem;
  }
  .skip:focus { top: 0.5rem; }

  /* ---------- nav ---------- */
  .site-nav-links { position: relative; }
  .site-nav-links ul { scrollbar-width: none; -ms-overflow-style: none; padding-right: 1.5rem; }
  .site-nav-links ul::-webkit-scrollbar { display: none; }
  /* right-edge fade tells phone users the row scrolls */
  .site-nav-links::after {
    content: ''; position: absolute; top: 0; right: 0; bottom: 0; width: 2.5rem; pointer-events: none;
    background: linear-gradient(to right, transparent, var(--background));
  }
  .nav-brand { display: inline-flex; }
  @media (max-width: 639px) { .site-nav .nav-brand, .site-nav .nav-resume { display: none; } }
  @media (min-width: 640px) { .site-nav-links::after { display: none; } .site-nav-links ul { padding-right: 0; } }
  .nav-link, .nav-icon {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0 0.7rem; border-radius: 0.5rem;
    font-size: 0.9rem; font-weight: 500; line-height: 1; text-decoration: none; color: inherit;
    transition: color 120ms ease;
  }
  .nav-icon { width: 44px; padding: 0; }
  .nav-link:hover, .nav-icon:hover { color: #2563eb; }
  :global(html.dark) .nav-link:hover, :global(html.dark) .nav-icon:hover { color: #60a5fa; }
