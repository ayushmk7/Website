---
// src/pages/options/5.astro — Option 5 "Monograph": classic serif academic CV on warm paper.
// Content comes only from src/lib/profile.ts. Layout: single 46rem column, numbered entries,
// small-caps labels (Libre Franklin), serif body (Newsreader). Light + dark, zero animation.
import ProLayout from '../../layouts/ProLayout.astro';
import OptionSwitcher from '../../components/OptionSwitcher.astro';
import {
  profile, contactLinks, sections, education,
  experience, hackathonsWithProject,
  featuredProjects, moreProjects,
  skillGroups, FUN_HREF,
} from '../../lib/profile';
import type { Project } from '../../lib/profile';

const ext = { target: '_blank', rel: 'noopener noreferrer' } as const;
const isWin = (placement: string) => /1st|winner/i.test(placement);
const primaryLink = (p: Project) => p.githubUrl ?? p.websiteUrl;
const byKey = Object.fromEntries(contactLinks.map((c) => [c.key, c]));
const social = contactLinks.filter((c) => c.key === 'github' || c.key === 'linkedin' || c.key === 'x');
const year = new Date().getFullYear();
---
<ProLayout title={`${profile.name} — ${profile.headline}`} bodyClass="mono">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Libre+Franklin:wght@500;600&display=swap"
    />
  </Fragment>

  <a class="skip" href="#main">Skip to content</a>

  <div class="page" id="top">
    <header class="masthead">
      <div class="mast-row">
        <a class="mast-name" href="#top">{profile.name}</a>
        <nav class="mast-nav" aria-label="Sections">
          <ul class="inline-list">
            {sections.map((s) => (
              <li><a class="sc sc-link" href={`#${s.id}`}>{s.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <div class="mast-row mast-row--2">
        <nav class="mast-nav" aria-label="Site">
          <ul class="inline-list">
            <li><a class="sc sc-link fun" href={FUN_HREF}>Fun mode</a></li>
            <li><a class="sc sc-link" href={profile.resumeHref} {...ext}>Résumé (PDF)</a></li>
            <li>
              <button class="sc sc-link theme-toggle" type="button">
                <span class="only-light">Night</span><span class="only-dark">Day</span>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero" aria-labelledby="name">
        <div class="hero-top">
          <img
            class="hero-photo"
            src={profile.photo}
            alt={profile.photoAlt}
            width="96"
            height="96"
            decoding="async"
          />
          <div class="hero-id">
            <h1 id="name">{profile.name}</h1>
            <p class="hero-headline">{profile.headline}</p>
            <ul class="inline-list sc hero-contacts">
              <li>{profile.location}</li>
              <li class="email-item">
                <a href={byKey.email.href}>{profile.email}</a>
                <button class="copy-email" type="button" data-email={profile.email} aria-label="Copy email address">copy</button>
              </li>
              {social.map((c) => (
                <li><a href={c.href} {...ext}>{c.label}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <p class="summary">{profile.summary}</p>
      </section>

      <!-- Experience -->
      <section class="section" id="experience" aria-labelledby="h-experience">
        <h2 id="h-experience" class="sc">Experience</h2>
        <ol class="entries">
          {experience.map((e, i) => (
            <li class="entry">
              <span class="num" aria-hidden="true">{i + 1}</span>
              <h3>{e.role}</h3>
              <p class="entry-meta">
                <span class="entry-org">
                  <em>
                    {e.url ? <a href={e.url} {...ext}>{e.company}</a> : e.company}{e.location ? `, ${e.location}` : ''}
                  </em>
                  {e.badge && <span class="sc badge">[{e.badge}]</span>}
                  <span class="sc kind">{e.kind}</span>
                </span>
                <span class="sc period">{e.period}</span>
              </p>
              <ul class="bullets">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </section>

      <!-- Projects -->
      <section class="section" id="projects" aria-labelledby="h-projects">
        <h2 id="h-projects" class="sc">Selected Projects</h2>
        <ol class="entries">
          {featuredProjects.map((p, i) => (
            <li class="entry">
              <span class="num" aria-hidden="true">{i + 1}</span>
              <h3>
                {p.title}
                <span class="marks">
                  {p.githubUrl && <a class="sc mark" href={p.githubUrl} {...ext}>GitHub<span aria-hidden="true">↗</span></a>}
                  {p.websiteUrl && <a class="sc mark" href={p.websiteUrl} {...ext}>Site<span aria-hidden="true">↗</span></a>}
                </span>
              </h3>
              <p class="sc tags">{p.tags.slice(0, 5).join(' · ')}</p>
              <p class="entry-body">{p.description}</p>
            </li>
          ))}
        </ol>

        <h2 class="sc h2-sub">Other Projects</h2>
        <ul class="biblio">
          {moreProjects.map((p) => (
            <li>
              {primaryLink(p)
                ? <a class="biblio-title" href={primaryLink(p)} {...ext}>{p.title}.</a>
                : <span class="biblio-title">{p.title}.</span>}
              {' '}{p.description}
              {p.githubUrl && p.websiteUrl && (
                <>{' '}<a class="sc mark" href={p.websiteUrl} {...ext}>Site<span aria-hidden="true">↗</span></a></>
              )}
            </li>
          ))}
        </ul>
      </section>

      <!-- Hackathons -->
      <section class="section" id="hackathons" aria-labelledby="h-hackathons">
        <h2 id="h-hackathons" class="sc">Awards and Hackathons</h2>
        <ol class="entries">
          {hackathonsWithProject.map((h, i) => (
            <li class="entry">
              <span class="num" aria-hidden="true">{i + 1}</span>
              <h3>{h.event}</h3>
              <p class="entry-meta">
                <span class="entry-org"><em>{h.organizer}</em></span>
                <span class="sc period">{h.date}</span>
              </p>
              <p class={`sc placement${isWin(h.placement) ? ' is-win' : ''}`}>
                {h.placement}{h.prize ? ` · ${h.prize}` : ''}
              </p>
              <p class="entry-body"><strong>{h.project}.</strong> {h.blurb}</p>
              {h.projectEntry && <p class="sc tags">{h.projectEntry.tags.slice(0, 5).join(' · ')}</p>}
              {(h.repoUrl || h.siteUrl) && (
                <ul class="inline-list sc links">
                  {h.repoUrl && <li><a href={h.repoUrl} {...ext}>Repository</a></li>}
                  {h.siteUrl && <li><a href={h.siteUrl} {...ext}>Site</a></li>}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </section>

      <!-- Skills -->
      <section class="section" id="skills" aria-labelledby="h-skills">
        <h2 id="h-skills" class="sc">Technical Skills</h2>
        <dl class="skills">
          {skillGroups.map((g) => (
            <div class="skills-row">
              <dt class="sc">{g.label}</dt>
              <dd>{g.featured.join(', ')}</dd>
            </div>
          ))}
        </dl>
        <details class="disclosure">
          <summary class="sc">Complete list</summary>
          <dl class="skills skills--all">
            {skillGroups.map((g) => (
              <div class="skills-row">
                <dt class="sc">{g.label}</dt>
                <dd>{g.all.join(', ')}</dd>
              </div>
            ))}
          </dl>
        </details>
      </section>

      <!-- Education -->
      <section class="section" id="education" aria-labelledby="h-education">
        <h2 id="h-education" class="sc">Education</h2>
        <ol class="entries">
          {education.map((ed) => (
            <li class="entry">
              <h3>{ed.url ? <a href={ed.url} {...ext}>{ed.institution}</a> : ed.institution}</h3>
              <p class="entry-body">{ed.degree}</p>
              <p class="sc period-line">{ed.period} · {ed.location}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Contact -->
      <section class="section" id="contact" aria-labelledby="h-contact">
        <h2 id="h-contact" class="sc">Contact</h2>
        <p class="entry-body">{profile.availability}</p>
        <ul class="inline-list sc contact-links">
          {contactLinks.map((c) => (
            <li>
              {c.external
                ? <a href={c.href} {...ext}>{c.label}</a>
                : <a href={c.href}>{c.label}</a>}
            </li>
          ))}
        </ul>
        <p class="big-mail">
          <a href={byKey.email.href}>{profile.email}</a>
          <button class="copy-email sc" type="button" data-email={profile.email} aria-label="Copy email address">copy</button>
        </p>
      </section>
    </main>

    <footer class="colophon">
      <p>
        Set in Newsreader and Libre Franklin. © {year} {profile.name}.
        {' '}<a class="fun" href={FUN_HREF}>Fun mode</a> · <a href="#top">Top</a>
      </p>
    </footer>
  </div>

  <OptionSwitcher />
</ProLayout>

<script is:inline>
  (function () {
    var t = document.querySelector('.theme-toggle');
    if (t) t.addEventListener('click', function () {
      var dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
    });
    var timers = new WeakMap();
    document.querySelectorAll('.copy-email').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var email = btn.getAttribute('data-email') || '';
        var fallback = function () { location.href = 'mailto:' + email; };
        if (!navigator.clipboard || !navigator.clipboard.writeText) return fallback();
        navigator.clipboard.writeText(email).then(function () {
          btn.textContent = 'copied';
          clearTimeout(timers.get(btn));
          timers.set(btn, setTimeout(function () { btn.textContent = 'copy'; }, 1600));
        }, fallback);
      });
    });
  })();
</script>

<style>
  /* ---------- tokens (on body so everything inherits) ---------- */
  :global(body.mono) {
    --paper: #f7f3ea;
    --paper-2: #efe9dc;
    --ink: #2b2620;
    --ink-soft: #5f574d;
    --rule: #d8d0c0;
    --accent: #7a2e2e;
    --link: #1f4e79;
    --serif: 'Newsreader', Georgia, 'Iowan Old Style', 'Times New Roman', serif;
    --sans: 'Libre Franklin', 'Helvetica Neue', Arial, sans-serif;

    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.65;
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  :global(html.dark body.mono) {
    --paper: #17150f;
    --paper-2: #1f1c15;
    --ink: #ece6d8;
    --ink-soft: #b5ab98;
    --rule: #37332a;
    --accent: #d98b8b;
    --link: #8ab4e8;
  }
  @media (min-width: 640px) {
    :global(body.mono) { font-size: 18px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html) { scroll-behavior: smooth; }
  }

  /* ---------- theme-dependent labels (no JS needed for the label) ---------- */
  .only-dark { display: none; }
  :global(html.dark) .only-dark { display: inline; }
  :global(html.dark) .only-light { display: none; }

  /* ---------- base ---------- */
  .page {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(1rem, 6vw, 3rem);
    padding-bottom: 5rem;
  }
  .page :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .skip:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  a { color: var(--link); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  a:hover { text-decoration-thickness: 2px; }
  a.fun { color: var(--accent); }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  img { max-width: 100%; height: auto; }
  p { margin: 0; }
  ul, ol { list-style: none; margin: 0; padding: 0; }
  em { font-style: italic; }
  strong { font-weight: 600; }
  h1, h2, h3 { margin: 0; }

  /* small caps: Libre Franklin, uppercase, tracked */
  .sc {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .sc a, a.sc { text-decoration: none; }
  .sc a:hover, a.sc:hover, .sc button:hover { text-decoration: underline; text-underline-offset: 0.25em; }

  /* tap-friendly small-caps links without growing the line box */
  .sc-link {
    display: inline-block;
    padding: 0.875rem 0;
    margin: -0.875rem 0;
    color: var(--ink);
  }
  a.sc-link { color: var(--ink); }

  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    padding: 0.5rem 0.75rem;
    background: var(--paper-2);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 13px;
    z-index: 10;
  }
  .skip:focus { top: 1rem; }

  /* inline rows: spaced by gap only (no separator glyphs), so a wrapped line never starts or ends with one */
  .inline-list { display: flex; flex-wrap: wrap; column-gap: 0.9rem; row-gap: 0.35em; align-items: baseline; }
  .inline-list > li { display: inline-flex; align-items: baseline; gap: 0.5em; white-space: nowrap; }

  /* ---------- masthead ---------- */
  .masthead {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .mast-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }
  .mast-row--2 { justify-content: flex-end; }
  .mast-name {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.005em;
  }
  a.mast-name { color: var(--ink); text-decoration: none; }
  a.mast-name:hover { text-decoration: underline; }
  .mast-nav .inline-list { column-gap: 1.1rem; }
  .theme-toggle { color: var(--ink); }

  /* ---------- hero ---------- */
  .hero { padding-top: 2.5rem; }
  .hero-top {
    display: grid;
    grid-template-columns: 96px 1fr;
    column-gap: 1.5rem;
    align-items: center;
  }
  .hero-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(2.1rem, 5.5vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 72;
  }
  .hero-headline {
    font-style: italic;
    font-size: 1.2rem;
    color: var(--ink-soft);
    margin-top: 0.35rem;
  }
  .hero-contacts { margin-top: 0.7rem; color: var(--ink-soft); }
  .hero-contacts a { color: var(--ink); }
  .hero-contacts .email-item { white-space: normal; }
  .hero-contacts .email-item a { overflow-wrap: anywhere; }
  .summary {
    margin-top: 1.75rem;
    font-size: 1.06em;
    text-align: left;
    max-width: 62ch;
  }

  /* drop cap only where there's room */
  @media (min-width: 640px) {
    .summary::first-letter {
      float: left;
      font-family: var(--serif);
      font-size: 3.2em;
      line-height: 0.8;
      font-weight: 500;
      padding: 0.08em 0.1em 0 0;
      color: var(--ink);
    }
  }

  .copy-email {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    line-height: 1.3;
    min-width: 2.75rem;
    text-align: center;
  }
  .copy-email:hover { border-color: var(--accent); }

  /* ---------- sections ---------- */
  .section {
    margin-top: 4.5rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
    scroll-margin-top: 1.5rem;
  }
  h2.sc { color: var(--accent); letter-spacing: 0.18em; margin-bottom: 1.75rem; }
  h2.h2-sub { margin-top: 3rem; }
  h3 {
    font-family: var(--serif);
    font-size: 1.3rem; /* ~21px at 16 base; scales with body */
    font-weight: 500;
    line-height: 1.3;
  }
  h3 > a { color: var(--ink); text-decoration-color: var(--rule); }
  h3 > a:hover { text-decoration-color: var(--link); }

  /* numbered entries: hanging numerals in the left margin on wide screens */
  .entries > .entry { position: relative; margin-top: 2.25rem; }
  .entries > .entry:first-child { margin-top: 0; }
  .num {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 44rem) {
    .num {
      position: absolute;
      left: -2.5rem;
      top: 0.4rem;
      width: 1.75rem;
      text-align: right;
    }
    .num::after { content: '.'; }
  }
  @media (max-width: 43.99rem) {
    .num { display: block; margin-bottom: 0.15rem; }
    .num::before { content: 'No. '; }
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.2rem 1.5rem;
    margin-top: 0.25rem;
    color: var(--ink-soft);
  }
  .entry-org { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.6em; }
  .entry-org em a { color: var(--link); }
  .badge { color: var(--accent); letter-spacing: 0.1em; }
  .kind { color: var(--ink-soft); }
  .period { color: var(--ink-soft); white-space: nowrap; }
  .period-line { color: var(--ink-soft); margin-top: 0.3rem; }

  .bullets { margin-top: 0.75rem; }
  .bullets > li { position: relative; padding-left: 1.25rem; margin-top: 0.35rem; }
  .bullets > li::before { content: '–'; position: absolute; left: 0; color: var(--ink-soft); }

  .entry-body { margin-top: 0.5rem; max-width: 62ch; }
  .tags { margin-top: 0.4rem; color: var(--ink-soft); letter-spacing: 0.1em; }
  .marks { display: inline-flex; gap: 0.75em; margin-left: 0.6em; vertical-align: 0.2em; }
  .mark { color: var(--accent); letter-spacing: 0.1em; white-space: nowrap; }
  .mark span { margin-left: 0.15em; }

  /* bibliography-style list with hanging indent */
  .biblio > li { padding-left: 1.5rem; text-indent: -1.5rem; margin-top: 0.8rem; max-width: 62ch; }
  .biblio > li:first-child { margin-top: 0; }
  .biblio-title { font-weight: 500; }
  .biblio .mark { text-indent: 0; }

  /* hackathons */
  .placement { margin-top: 0.6rem; color: var(--ink-soft); letter-spacing: 0.1em; }
  .placement.is-win { color: var(--accent); }
  .links { margin-top: 0.5rem; }
  .links a { color: var(--accent); }

  /* skills */
  .skills-row { display: grid; grid-template-columns: 1fr; gap: 0.15rem 1.25rem; padding: 0.7rem 0; border-top: 1px solid var(--rule); }
  .skills-row:first-child { border-top: 0; padding-top: 0; }
  .skills dt { color: var(--ink-soft); }
  .skills dd { margin: 0; }
  @media (min-width: 640px) {
    .skills-row { grid-template-columns: 14rem 1fr; }
  }
  .disclosure { margin-top: 1.25rem; }
  .disclosure > summary {
    cursor: pointer;
    color: var(--accent);
    list-style: none;
    display: inline-block;
    padding: 0.875rem 0;
    margin: -0.875rem 0;
  }
  .disclosure > summary::-webkit-details-marker { display: none; }
  .disclosure > summary::before { content: '+'; display: inline-block; width: 1.1em; }
  .disclosure[open] > summary::before { content: '–'; }
  .disclosure > summary:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  .skills--all { margin-top: 2rem; }
  .skills--all .skills-row:first-child { border-top: 1px solid var(--rule); padding-top: 0.7rem; }

  /* contact */
  .contact-links { margin-top: 1rem; }
  .contact-links a { color: var(--ink); }
  .big-mail {
    margin-top: 1.5rem;
    font-size: clamp(1.25rem, 3.5vw, 1.6rem);
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .big-mail a { color: var(--ink); overflow-wrap: anywhere; text-decoration-color: var(--rule); }
  .big-mail a:hover { text-decoration-color: var(--accent); }

  /* colophon */
  .colophon {
    margin-top: 5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: 14px;
  }
  .colophon a { color: var(--ink-soft); }
  .colophon a.fun { color: var(--accent); }

  /* ---------- mobile ---------- */
  @media (max-width: 639.98px) {
    .hero { padding-top: 2rem; }
    .hero-top { grid-template-columns: 1fr; row-gap: 1rem; justify-items: center; text-align: center; }
    .hero-contacts { justify-content: center; }
    .mast-row, .mast-row--2 { justify-content: flex-start; }
    .period { white-space: normal; }
  }

  /* ---------- print: a clean paper CV ---------- */
  @media print {
    :global(body.mono) { background: #fff; color: #000; font-size: 11pt; }
    :global(.opt-switch), .mast-row--2, .copy-email, .skip, .colophon a { display: none !important; }
    .page { max-width: none; padding: 0; }
    .page a { color: #000; text-decoration: none; }
