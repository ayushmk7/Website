---
// src/pages/options/2.astro — Option 2 "Terminal"
// A $-prompt page. Sections are commands, projects are a tree, everything is greppable.
// Dark-first (paper-terminal light variant). JetBrains Mono only. No gimmicks: plain text, no typing delays.
// Content comes exclusively from src/lib/profile.ts.
import ProLayout from '../../layouts/ProLayout.astro';
import OptionSwitcher from '../../components/OptionSwitcher.astro';
import {
  profile, contactLinks, sections, education,
  experience, hackathons,
  featuredProjects, moreProjects,
  skillGroups, FUN_HREF,
} from '../../lib/profile';
import type { Project, SkillCategoryKey } from '../../lib/profile';

// --- local derivations (not in the shared contract) ---------------------------------
const isCurrent = (period: string) => /present/i.test(period);
const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/+$/, '');
const showHref = (href: string) => href.replace(/^mailto:/, '').replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/+$/, '');
const status = profile.availability.split('. ')[0].replace(/^\w/, (c) => c.toLowerCase());
const year = new Date().getFullYear();

// TOML-ish table names for the skills section (visual only; the accessible name is group.label)
const tomlName: Record<SkillCategoryKey, string> = {
  programmingLanguages: 'languages',
  aiMl: 'ai_ml',
  softwareDevelopment: 'software',
  databases: 'data',
  devOps: 'devops_cloud',
  cybersecurity: 'security',
  coreCs: 'core_cs',
};
const restOf = (g: { all: string[]; featured: string[] }) => g.all.filter((s) => !g.featured.includes(s));

// Keyboard jump map, shown in the help line. `g` then a letter.
const keys: { k: string; id: string; label: string }[] = [
  { k: 'e', id: 'experience', label: 'experience' },
  { k: 'p', id: 'projects', label: 'projects' },
  { k: 'h', id: 'hackathons', label: 'hackathons' },
  { k: 's', id: 'skills', label: 'skills' },
  { k: 'd', id: 'education', label: 'education' },
  { k: 'c', id: 'contact', label: 'contact' },
  { k: 't', id: 'top', label: 'top' },
];

const projectLinks = (p: Project) => [
  p.githubUrl ? { label: 'github', href: p.githubUrl } : null,
  p.websiteUrl ? { label: 'site', href: p.websiteUrl } : null,
].filter(Boolean) as { label: string; href: string }[];

const title = `${profile.name} — ${profile.headline}`;
---
<ProLayout title={title} bodyClass="opt2">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" />
  </Fragment>

  <a class="skip" href="#main">skip to content</a>

  <header class="bar">
    <div class="bar__in">
      <span class="ps"><span class="host">ayush@umich</span>:~$<span class="sr-only"> {profile.name}</span></span>
      <nav class="bar__nav" aria-label="Quick links">
        <a class="bl" href={FUN_HREF}>[fun mode]</a>
        <button class="bl" type="button" data-theme-toggle aria-label="Toggle light or dark theme">[theme]</button>
        <a class="bl" href={profile.resumeHref} target="_blank" rel="noopener noreferrer">[resume.pdf]</a>
      </nav>
    </div>
  </header>

  <main id="main" class="term">
    <nav class="help" aria-label="Sections">
      <p class="c"><span aria-hidden="true"># </span>sections:
        {sections.map((s) => <><a href={`#${s.id}`}>{s.label.toLowerCase()}</a>{' '}</>)}
      </p>
      <p class="c keys" aria-hidden="true"># keys: {keys.filter((k) => k.k !== 't').map((k) => <span>g&nbsp;{k.k}</span>)}</p>
    </nav>

    <!-- ===== whoami ===== -->
    <section id="top" class="hero" aria-labelledby="h-whoami" tabindex="-1">
      <p class="cmd" aria-hidden="true"><span class="ps1">$</span><span class="cmd__t">whoami</span></p>
      <div class="out hero__grid">
        <div>
          <h1 id="h-whoami">{profile.name}<span class="cursor" aria-hidden="true"></span></h1>
          <dl class="kv">
            <dt>role</dt><dd>{profile.headline}</dd>
            <dt>focus</dt><dd>{profile.tagline}</dd>
            <dt>location</dt><dd>{profile.location}</dd>
            <dt>status</dt><dd>{status}</dd>
          </dl>
          <p class="c summary"><span aria-hidden="true"># </span>{profile.summary}</p>
          <ul class="links" aria-label="Contact links">
            {contactLinks.map((l) => (
              <li>
                {l.external ? (
                  <a href={l.href} target="_blank" rel="noopener noreferrer">{showHref(l.href)}</a>
                ) : (
                  <a href={l.href}>{showHref(l.href)}</a>
                )}
                {l.key === 'email' && (
                  <button class="bl copy" type="button" data-copy={profile.email} aria-label="Copy email address">[copy]</button>
                )}
              </li>
            ))}
          </ul>
        </div>
        <img class="photo" src={profile.photo} alt={profile.photoAlt} width="64" height="64" />
      </div>
    </section>

    <!-- ===== experience ===== -->
    <section id="experience" aria-labelledby="h-experience" tabindex="-1">
      <h2 id="h-experience" class="cmd"><span class="ps1" aria-hidden="true">$</span><span class="cmd__t"><span aria-hidden="true">cat </span>experience<span aria-hidden="true">.md</span></span></h2>
      <div class="out">
        <ol class="plain xp">
          {experience.map((e) => (
            <li class="xp__item">
              <div class="xp__head">
                <h3>
                  {isCurrent(e.period) && <span class="dot" aria-hidden="true">●</span>}
                  <b>{e.company}</b> <span class="muted" aria-hidden="true">—</span> {e.role}
                  {isCurrent(e.period) && <span class="sr-only"> (current)</span>}
                </h3>
                <span class="period">{e.period}</span>
              </div>
              <p class="meta">
                {e.kind}
                {e.location && <><span aria-hidden="true"> · </span>{e.location}</>}
                {e.url && <><span aria-hidden="true"> · </span><a class="bl" href={e.url} target="_blank" rel="noopener noreferrer">[{host(e.url)}]</a></>}
                {e.badge && <span class="badge">[{e.badge}]</span>}
              </p>
              <ul class="dash">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===== projects ===== -->
    <section id="projects" aria-labelledby="h-projects" tabindex="-1">
      <h2 id="h-projects" class="cmd"><span class="ps1" aria-hidden="true">$</span><span class="cmd__t"><span aria-hidden="true">tree </span>projects<span aria-hidden="true">/</span></span></h2>
      <div class="out">
        <ul class="plain tree">
          {featuredProjects.map((p) => (
            <li class="node">
              <div class="line">
                <span class="g" aria-hidden="true">├── </span>
                <div class="line__body">
                  <h3>{p.title}<span aria-hidden="true">/</span></h3>
                  {projectLinks(p).map((l) => (
                    <a class="bl" href={l.href} target="_blank" rel="noopener noreferrer">[{l.label}]</a>
                  ))}
                </div>
              </div>
              <div class="line">
                <span class="g" aria-hidden="true">│   ├── </span>
                <p class="tags"><span class="sr-only">Stack: </span>{p.tags.join(' · ')}</p>
              </div>
              <div class="line">
                <span class="g" aria-hidden="true">│   └── </span>
                <p>{p.description}</p>
              </div>
            </li>
          ))}
          <li class="node">
            <details class="more">
              <summary>
                <span class="g" aria-hidden="true">└── </span>
                <span class="more__t">more/ <span class="muted">({moreProjects.length} projects)</span></span>
                <span class="bl more__hint" aria-hidden="true"></span>
              </summary>
              <ul class="plain">
                {moreProjects.map((p, i) => (
                  <li class="line">
                    <span class="g" aria-hidden="true">{i === moreProjects.length - 1 ? '    └── ' : '    ├── '}</span>
                    <div class="line__prose">
                      <h3>{p.title}</h3>
                      <span class="muted" aria-hidden="true"> — </span>
                      <span>{p.description}</span>
                      {p.tags.length > 0 && (
                        <span class="tags"> <span class="sr-only">Stack: </span>{p.tags.slice(0, 3).join(' · ')}</span>
                      )}
                      {projectLinks(p).map((l) => (
                        <> <a class="bl" href={l.href} target="_blank" rel="noopener noreferrer">[{l.label}]</a></>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        </ul>
      </div>
    </section>

    <!-- ===== hackathons ===== -->
    <section id="hackathons" aria-labelledby="h-hackathons" tabindex="-1">
      <h2 id="h-hackathons" class="cmd"><span class="ps1" aria-hidden="true">$</span><span class="cmd__t"><span aria-hidden="true">ls -la </span>hackathons<span aria-hidden="true">/</span></span></h2>
      <div class="out">
        <table class="hk">
          <caption class="sr-only">Hackathons: date, placement, event, project and links</caption>
          <thead>
            <tr><th scope="col">date</th><th scope="col">placement</th><th scope="col">event</th><th scope="col">project</th><th scope="col">links</th></tr>
          </thead>
          <tbody>
            {hackathons.map((h) => (
              <>
                <tr class="hk__row">
                  <td class="hk__date" data-label="date">{h.date}</td>
                  <td class="hk__place" data-label="placement">
                    <span class="amber">{h.placement}</span>
                    {h.prize && <span class="muted"> · {h.prize}</span>}
                  </td>
                  <td class="hk__event">
                    <h3>{h.event}</h3>
                    <span class="muted hk__org">{h.organizer}</span>
                  </td>
                  <td class="hk__proj" data-label="project">{h.project}</td>
                  <td class="hk__links" data-label="links">
                    {h.repoUrl && <a class="bl" href={h.repoUrl} target="_blank" rel="noopener noreferrer">[repo]</a>}
                    {h.siteUrl && <a class="bl" href={h.siteUrl} target="_blank" rel="noopener noreferrer">[site]</a>}
                    {!h.repoUrl && !h.siteUrl && <span class="muted">—</span>}
                  </td>
                </tr>
                <tr class="hk__blurb">
                  <td colspan="5"><span class="c"><span aria-hidden="true"># </span>{h.blurb}</span></td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ===== skills ===== -->
    <section id="skills" aria-labelledby="h-skills" tabindex="-1">
      <h2 id="h-skills" class="cmd"><span class="ps1" aria-hidden="true">$</span><span class="cmd__t"><span aria-hidden="true">cat </span>skills<span aria-hidden="true">.toml</span></span></h2>
      <div class="out">
        <ul class="plain toml">
          {skillGroups.map((g) => (
            <li class="toml__group">
              <h3><span class="amber" aria-hidden="true">[{tomlName[g.key]}]</span><span class="sr-only">{g.label}</span>{' '}<span class="c toml__label" aria-hidden="true"># {g.label}</span></h3>
              <p class="toml__vals">{g.featured.join(', ')}</p>
              {restOf(g).length > 0 && (
                <details class="rest">
                  <summary><span aria-hidden="true"># </span>+{restOf(g).length} more<span class="sr-only"> in {g.label}</span></summary>
                  <p class="toml__vals muted">{restOf(g).join(', ')}</p>
                </details>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== education ===== -->
    <section id="education" aria-labelledby="h-education" tabindex="-1">
      <h2 id="h-education" class="cmd"><span class="ps1" aria-hidden="true">$</span><span class="cmd__t"><span aria-hidden="true">cat </span>education<span aria-hidden="true">.txt</span></span></h2>
      <div class="out">
        {education.map((ed) => (
          <div class="edu">
            <h3>{ed.degree}</h3>
            <p>
              {ed.url ? (
                <a href={ed.url} target="_blank" rel="noopener noreferrer">{ed.institution}</a>
              ) : ed.institution}
            </p>
            <p class="muted">{ed.period}<span aria-hidden="true"> · </span>{ed.location}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== contact ===== -->
    <section id="contact" aria-labelledby="h-contact" tabindex="-1">
      <h2 id="h-contact" class="cmd"><span class="ps1" aria-hidden="true">$</span><span class="cmd__t"><span aria-hidden="true">whoami --</span>contact</span></h2>
      <div class="out">
        <dl class="kv contact">
          {contactLinks.map((l) => (
            <>
              <dt>{l.label === 'Résumé' ? 'resume' : l.label.toLowerCase()}</dt>
              <dd>
                {l.external ? (
                  <a href={l.href} target="_blank" rel="noopener noreferrer">{showHref(l.href)}</a>
                ) : (
                  <a href={l.href}>{showHref(l.href)}</a>
                )}
                {l.key === 'email' && (
                  <button class="bl copy" type="button" data-copy={profile.email} aria-label="Copy email address">[copy]</button>
                )}
              </dd>
            </>
          ))}
        </dl>
        <p class="c"><span aria-hidden="true"># </span>{profile.availability}</p>
      </div>
    </section>

    <footer class="foot">
      <p class="c">
        <span aria-hidden="true"># </span>© {year} {profile.name}<span aria-hidden="true"> · </span>built with astro<span aria-hidden="true"> · </span>
        <a class="bl" href={FUN_HREF}>[fun mode]</a>
        <a class="bl" href="#top">[top]</a>
      </p>
    </footer>
  </main>

  <OptionSwitcher />
</ProLayout>

<style>
  /* ---------- tokens (dark default; paper-terminal light) ---------- */
  :global(body.opt2) {
    --bg: #0b0f14;
    --panel: #10161d;
    --fg: #d7dee7;
    --muted: #7f8b99;
    --green: #3ddc84;
    --amber: #f0b429;
    --blue: #6cb6ff;
    --rule: #1f2933;
    --selection: rgba(61, 220, 132, 0.25);
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --fs: 14.5px;

    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--mono);
    font-size: var(--fs);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }
  :global(html:not(.dark) body.opt2) {
    --bg: #fafaf7;
    --panel: #f1f1ec;
    --fg: #1a1f24;
    --muted: #5c6670;
    --green: #0f7a3d;
    --amber: #9a6200;
    --blue: #0b5cad;
    --rule: #d9d9d2;
    --selection: rgba(15, 122, 61, 0.2);
  }
  @media (min-width: 1024px) {
    :global(body.opt2) { --fs: 15.5px; }
  }
  :global(body.opt2 ::selection) { background: var(--selection); }
  :global(body.opt2 img) { max-width: 100%; height: auto; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html) { scroll-behavior: smooth; }
  }

  /* ---------- utilities ---------- */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .plain { list-style: none; margin: 0; padding: 0; }
  .muted { color: var(--muted); }
  .amber { color: var(--amber); }
  .c { color: var(--muted); margin: 0; }  /* comment line */
  b { font-weight: 700; }

  a { color: var(--green); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--green) 45%, transparent); text-underline-offset: 3px; overflow-wrap: anywhere; }
  a:hover { text-decoration-color: currentColor; }
  a:focus-visible, button:focus-visible, summary:focus-visible, .skip:focus {
    outline: 2px solid var(--green);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* bracket link / button: [label] */
  .bl {
    display: inline-block;
    color: var(--green);
    text-decoration: none;
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    white-space: nowrap;
  }
  .bl:hover { text-decoration: underline; text-underline-offset: 3px; }

  .skip {
    position: absolute; left: 1rem; top: -100px; z-index: 100;
    padding: 0.5rem 0.75rem; background: var(--panel); color: var(--green); border: 1px solid var(--rule);
  }
  .skip:focus { top: 0.5rem; }

  /* ---------- top bar ---------- */
  .bar {
    position: sticky; top: 0; z-index: 20;
    background: var(--panel);
    border-bottom: 1px solid var(--rule);
  }
  .bar__in {
    max-width: 88ch;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem);
    min-height: 44px;
    display: flex; align-items: center; justify-content: space-between; gap: 1ch;
  }
  .ps { color: var(--green); font-weight: 700; white-space: nowrap; }
  .bar__nav { display: flex; align-items: center; gap: 1ch; }
  .bar__nav .bl { min-height: 40px; display: inline-flex; align-items: center; padding: 0 2px; }
  @media (max-width: 479px) { .host { display: none; } }

  /* ---------- page column ---------- */
  .term {
    max-width: 88ch;
    margin: 0 auto;
    padding: 1.5rem clamp(1rem, 4vw, 2rem) 4rem;
  }
  .help { margin: 0 0 2.5rem; }
  .help p { margin: 0; }
  .help a { margin-right: 2ch; overflow-wrap: normal; white-space: nowrap; }
  .keys { display: none; }
  .keys span { margin-right: 2ch; }
  @media (min-width: 768px) { .keys { display: block; } }

  section { margin: 0 0 3rem; scroll-margin-top: 60px; }
  section:focus { outline: none; }

  /* command line = heading */
  .cmd {
    display: flex; align-items: baseline;
    margin: 0 0 0.75rem;
    font-size: inherit; font-weight: 700; color: var(--fg);
  }
  .ps1 { color: var(--green); flex: none; width: 2ch; }
  h2.cmd { margin-bottom: 1rem; }
  .out { padding-left: 2ch; }
  @media (max-width: 479px) { .out { padding-left: 0; } }

  h1, h2, h3 { font-size: inherit; font-weight: 700; margin: 0; line-height: inherit; }
  h1 { font-size: clamp(22px, 3vw, 28px); line-height: 1.3; margin: 0 0 1rem; }
  p { margin: 0; }

  /* blinking block cursor after the name */
  .cursor {
    display: inline-block; width: 0.55em; height: 1em; margin-left: 0.25em;
    background: var(--green); vertical-align: -0.12em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor { animation: blink 1.1s steps(1, end) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
  }

  /* ---------- hero ---------- */
  .hero__grid { display: flex; gap: 2rem; align-items: flex-start; }
  .hero__grid > div { min-width: 0; flex: 1; }
  .photo {
    display: none; flex: none;
    width: 64px; height: 64px; object-fit: cover;
    border: 1px solid var(--rule); border-radius: 2px;
  }
  @media (min-width: 768px) { .photo { display: block; } }

  .kv { display: grid; grid-template-columns: 10ch 1fr; gap: 0 1ch; margin: 0 0 1rem; }
  .kv dt { color: var(--muted); }
  .kv dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  @media (max-width: 479px) {
    .kv { grid-template-columns: 1fr; }
    .kv dd { margin: 0 0 0.5rem; }
  }
  .summary { margin: 0 0 1rem; max-width: 80ch; }
  .links { display: flex; flex-wrap: wrap; gap: 0.25rem 2ch; }
  .links li { display: inline-flex; gap: 1ch; align-items: baseline; }

  /* copy button feedback */
  .copy[data-done] { color: var(--amber); }

  /* ---------- experience ---------- */
  .xp__item { margin: 0 0 1.5rem; }
  .xp__head { display: flex; flex-wrap: wrap; gap: 0 2ch; align-items: baseline; }
  .xp__head h3 { min-width: 0; }
  .period { margin-left: auto; color: var(--muted); white-space: nowrap; }
  @media (max-width: 767px) { .period { margin-left: 0; flex-basis: 100%; } }
  .dot { color: var(--green); margin-right: 1ch; }
  .meta { color: var(--muted); display: flex; flex-wrap: wrap; gap: 0 1ch; }
  .badge { color: var(--amber); margin-left: auto; white-space: nowrap; }
  @media (max-width: 767px) { .badge { margin-left: 0; } }

  .dash { list-style: none; margin: 0.35rem 0 0; padding: 0; max-width: 80ch; }
  .dash li { padding-left: 2ch; text-indent: -2ch; margin: 0 0 0.25rem; }
  .dash li::before { content: '- '; color: var(--muted); }

  /* ---------- projects (tree) ---------- */
  .tree { max-width: 84ch; }
  .node { margin: 0; }
  .line { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; }
  .g { color: var(--muted); white-space: pre; user-select: none; }
  .line__body { display: flex; flex-wrap: wrap; gap: 0 1ch; align-items: baseline; min-width: 0; overflow-wrap: anywhere; }
  .line__prose { min-width: 0; overflow-wrap: anywhere; }
  .line__prose h3 { display: inline; }
  .tags { color: var(--blue); }
  .node + .node { margin-top: 0.75rem; }

  details.more > summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: auto auto 1fr; align-items: baseline; gap: 0 1ch; }
  details.more > summary::-webkit-details-marker { display: none; }
  details.more > summary .g { grid-column: 1; }
  details.more .more__t { font-weight: 700; }
  details.more .more__hint::before { content: '[expand]'; }
  details.more[open] .more__hint::before { content: '[collapse]'; }
  details.more > ul { margin-top: 0.5rem; }
  details.more > ul > .line { margin: 0 0 0.35rem; }

  /* ---------- hackathons (ls -la) ---------- */
  .hk { width: 100%; border-collapse: collapse; }
  .hk th { text-align: left; color: var(--muted); font-weight: 400; padding: 0 2ch 0.35rem 0; vertical-align: top; border-bottom: 1px solid var(--rule); }
  .hk td { padding: 0.6rem 2ch 0 0; vertical-align: top; }
  .hk td:last-child, .hk th:last-child { padding-right: 0; }
  .hk__date { white-space: nowrap; color: var(--muted); }
  .hk__org { display: block; }
  .hk__links .bl { margin-right: 1ch; }
  .hk__blurb td { padding: 0.15rem 0 0.75rem; border-bottom: 1px solid var(--rule); }
  .hk__blurb .c { display: block; max-width: 80ch; }
  .hk tbody tr:last-child td { border-bottom: 0; }

  @media (max-width: 767px) {
    .hk, .hk tbody { display: block; }
    .hk thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
    .hk tr { display: flex; flex-wrap: wrap; gap: 0 2ch; }
    .hk__row { padding-top: 0.75rem; }
    .hk td { display: block; padding: 0; }
    .hk__event { order: -1; flex-basis: 100%; margin-bottom: 0.15rem; }
    .hk__date, .hk__place, .hk__proj, .hk__links { flex-basis: 100%; }
    .hk td[data-label]::before { content: attr(data-label) ': '; color: var(--muted); }
    .hk__date { color: var(--fg); }
    .hk__blurb td { padding: 0.25rem 0 0.75rem; flex-basis: 100%; }
  }

  /* ---------- skills (toml) ---------- */
  .toml__group { margin: 0 0 1.1rem; }
  .toml__group h3 { font-weight: 700; }
  .toml__label { font-weight: 400; }
  .toml__vals { max-width: 80ch; overflow-wrap: anywhere; }
  details.rest > summary { list-style: none; cursor: pointer; color: var(--green); display: inline-block; }
  details.rest > summary::-webkit-details-marker { display: none; }
  details.rest > summary::after { content: ' ▸'; }
  details.rest[open] > summary::after { content: ' ▾'; }
  details.rest > p { margin-top: 0.15rem; }

  /* ---------- education / contact / footer ---------- */
  .edu h3 { margin: 0 0 0.15rem; overflow-wrap: anywhere; }
  .contact { grid-template-columns: 10ch 1fr; margin-bottom: 1rem; }
  .contact dd { display: flex; flex-wrap: wrap; gap: 0 1ch; align-items: baseline; }
  .foot { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
  .foot .bl { margin-right: 1ch; }

  @media print {
    :global(.opt-switch) { display: none; }
    .bar, .keys, .cursor { display: none; }
    details { display: block; }
    details > summary { display: none; }
  }
</style>

<script>
  (function () {
    var root = document.documentElement;

    // [theme] — toggles html.dark and persists; ProLayout applies it before paint on the next load.
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach(function (b) {
      b.addEventListener('click', function () {
        var dark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      });
    });

    // [copy] — clipboard, falls back to mailto.
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = b.getAttribute('data-copy') || '';
        var fallback = function () { location.href = 'mailto:' + v; };
        var done = function () {
          var t = b.textContent;
          b.textContent = '[copied]';
          b.setAttribute('data-done', '');
          setTimeout(function () { b.textContent = t; b.removeAttribute('data-done'); }, 1500);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(v).then(done, fallback);
        else fallback();
      });
    });

    // g-key jumps: `g` then e/p/h/s/d/c/t. Ignored while typing; never touches `[` / `]`.
    var map: Record<string, string> = { e: 'experience', p: 'projects', h: 'hackathons', s: 'skills', d: 'education', c: 'contact', t: 'top' };
    var armed = false;
    var timer: ReturnType<typeof setTimeout> | undefined;
    document.addEventListener('keydown', function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      var t = e.target as HTMLElement | null;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      if (!armed) {
        if (e.key === 'g') { armed = true; clearTimeout(timer); timer = setTimeout(function () { armed = false; }, 1500); }
        return;
      }
      armed = false; clearTimeout(timer);
      var id = map[e.key];
      if (!id) return;
      var el = document.getElementById(id);
      if (!el) return;
      e.preventDefault();
      el.scrollIntoView({ block: 'start' });
      el.focus({ preventScroll: true });
    });
  })();
</script>
