---
// src/pages/options/2.astro — Option 2 "Dossier"
// Two-column résumé: identity / contact / skills / education pinned in a navy sidebar,
// the story (summary, experience, projects, hackathons) scrolls on the right.
// Cmd+P prints a clean paper CV. Content comes only from src/lib/profile.
import ProLayout from '../../layouts/ProLayout.astro';
import OptionSwitcher from '../../components/OptionSwitcher.astro';
import {
  profile, contactLinks, sections, education,
  experience, hackathons, featuredProjects, moreProjects,
  skillGroups, stats, FUN_HREF,
} from '../../lib/profile';

const ext = { target: '_blank', rel: 'noopener noreferrer' } as const;
const sideContacts = contactLinks.filter((l) => l.key !== 'resume');
const updated = new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const navItems = [{ id: 'summary', label: 'Summary' }, ...sections.filter((s) => s.id !== 'contact')];
const isWin = (p: string) => /1st|winner/i.test(p);

// 16px inline icons, stroke 2, currentColor.
const svg = (body: string, vb = '0 0 24 24') =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${vb}" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${body}</svg>`;
const icons: Record<string, string> = {
  email: svg('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>'),
  github: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>`,
  x: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.48l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41z"/></svg>`,
  file: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/>'),
  pin: svg('<path d="M12 22s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/>'),
  link: svg('<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>'),
  arrow: svg('<path d="M7 17 17 7"/><path d="M8 7h9v9"/>'),
  copy: svg('<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/>'),
  spark: svg('<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6.5 6.5l2.5 2.5M15 15l2.5 2.5M6.5 17.5 9 15M15 9l2.5-2.5"/>'),
  cal: svg('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>'),
  trophy: svg('<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3"/>'),
};
---
<ProLayout title={`${profile.name} — ${profile.headline}`} bodyClass="d3-body">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:wght@600&display=swap" />
  </Fragment>

  <div class="d3">
    <div class="d3-sheet">
      <!-- ============================ SIDEBAR ============================ -->
      <aside class="d3-side" aria-label="Profile, contact, skills and education">
        <div class="d3-id">
          <img class="d3-photo" src={profile.photo} alt={profile.photoAlt} width="112" height="112" decoding="async" />
          <h1 class="d3-name">{profile.name}</h1>
          <p class="d3-headline">{profile.headline}</p>
          <p class="d3-tagline">{profile.tagline}</p>
          <p class="d3-loc"><Fragment set:html={icons.pin} /> {profile.location}</p>
          <nav class="d3-nav" aria-label="Page sections">
            <ul>
              {navItems.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
            </ul>
          </nav>
        </div>

        <section class="d3-contact" id="contact" aria-labelledby="d3-contact-h">
          <h2 id="d3-contact-h" class="d3-side-h">Contact</h2>
          <ul class="d3-clist">
            {sideContacts.map((l) => (
              <li>
                <a class="d3-clink" href={l.href} {...(l.external ? ext : {})}>
                  <span class="d3-ico"><Fragment set:html={icons[l.key]} /></span>
                  <span class="d3-clabel">{l.label}</span>
                  <span class="d3-chandle">{l.handle}</span>
                </a>
                {l.key === 'email' && (
                  <button type="button" class="d3-copy" data-copy={profile.email} aria-label="Copy email address" title="Copy email">
                    <Fragment set:html={icons.copy} /><span class="d3-copy-t">Copy</span>
                  </button>
                )}
              </li>
            ))}
          </ul>
          <p class="d3-avail">{profile.availability}</p>
        </section>

        <div class="d3-actions">
          <a class="d3-btn d3-btn-solid" href={profile.resumeHref} {...ext}>
            <Fragment set:html={icons.file} /> Download résumé (PDF)
          </a>
          <a class="d3-btn d3-btn-outline d3-fun" href={FUN_HREF}>
            <Fragment set:html={icons.spark} /> Fun mode
          </a>
        </div>

        <section class="d3-skills" id="skills" aria-labelledby="d3-skills-h">
          <h2 id="d3-skills-h" class="d3-side-h">Skills</h2>
          <div class="d3-sgs">
            {skillGroups.map((g) => (
              <div class="d3-sg">
                <h3 class="d3-sg-h">{g.shortLabel}</h3>
                <ul class="d3-pills" aria-label={g.label}>
                  {g.featured.map((s) => <li>{s}</li>)}
                </ul>
              </div>
            ))}
          </div>
          <details class="d3-allskills">
            <summary>All skills ({skillGroups.reduce((n, g) => n + g.all.length, 0)})</summary>
            <dl>
              {skillGroups.map((g) => (
                <>
                  <dt>{g.label}</dt>
                  <dd>{g.all.join(', ')}</dd>
                </>
              ))}
            </dl>
          </details>
        </section>

        <section class="d3-edu" id="education" aria-labelledby="d3-edu-h">
          <h2 id="d3-edu-h" class="d3-side-h">Education</h2>
          {education.map((e) => (
            <div class="d3-edu-e">
              <h3 class="d3-edu-deg">{e.degree}</h3>
              <p class="d3-edu-inst">
                {e.url ? <a href={e.url} {...ext}>{e.institution}</a> : e.institution}
              </p>
              <p class="d3-edu-meta">{e.period} · {e.location}</p>
            </div>
          ))}
        </section>

        <div class="d3-theme">
          <button type="button" class="d3-theme-btn" id="d3-theme" aria-pressed="false">Dark mode</button>
        </div>
      </aside>

      <!-- ============================== MAIN ============================== -->
      <main class="d3-main">
        <section id="summary" class="d3-sec" aria-labelledby="d3-summary-h">
          <h2 id="d3-summary-h" class="d3-h2">Summary</h2>
          <p class="d3-summary">{profile.summary}</p>
          <p class="d3-stats" aria-label="Quick facts">
            <span><b>{stats.roles}</b> roles</span>
            <span class="d3-dot" aria-hidden="true">·</span>
            <span><b>{stats.hackathonPlacements}</b> hackathon placements <span class="d3-muted">({stats.hackathonWins} wins)</span></span>
            <span class="d3-dot" aria-hidden="true">·</span>
            <span><b>{stats.projects}</b> projects</span>
            <span class="d3-dot" aria-hidden="true">·</span>
            <span>graduating <b>{stats.graduation}</b></span>
          </p>
        </section>

        <section id="experience" class="d3-sec" aria-labelledby="d3-exp-h">
          <h2 id="d3-exp-h" class="d3-h2">Experience</h2>
          <div class="d3-xp">
            {experience.map((e) => (
              <article class="d3-xp-e">
                <div class="d3-xp-row">
                  <h3 class="d3-h3">{e.role}</h3>
                  <span class="d3-period">{e.period}</span>
                </div>
                <p class="d3-xp-meta">
                  <span class="d3-company">
                    {e.url ? <a href={e.url} {...ext}>{e.company} <Fragment set:html={icons.arrow} /></a> : e.company}
                  </span>
                  {e.location && <span class="d3-muted d3-xp-loc">· {e.location}</span>}
                  {e.badge && <span class="d3-badge">{e.badge}</span>}
                  <span class="d3-kind">{e.kind}</span>
                </p>
                <ul class="d3-bullets">
                  {e.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section id="projects" class="d3-sec" aria-labelledby="d3-proj-h">
          <h2 id="d3-proj-h" class="d3-h2">Projects</h2>
          <ul class="d3-cards">
            {featuredProjects.map((p) => (
              <li class="d3-card">
                <h3 class="d3-h3">{p.title}</h3>
                <ul class="d3-tags" aria-label="Technologies">
                  {p.tags.slice(0, 5).map((t) => <li>{t}</li>)}
                  {p.tags.length > 5 && <li class="d3-tag-more">+{p.tags.length - 5}</li>}
                </ul>
                <p class="d3-card-desc">{p.description}</p>
                <p class="d3-links">
                  {p.githubUrl && <a href={p.githubUrl} {...ext}><Fragment set:html={icons.github} /> GitHub</a>}
                  {p.websiteUrl && <a href={p.websiteUrl} {...ext}><Fragment set:html={icons.link} /> Site</a>}
                </p>
              </li>
            ))}
          </ul>
          <details class="d3-more">
            <summary>More projects ({moreProjects.length})</summary>
            <ul class="d3-more-list">
              {moreProjects.map((p) => {
                const href = p.githubUrl ?? p.websiteUrl;
                return (
                  <li>
                    <h3 class="d3-more-t">
                      {href ? <a href={href} {...ext}>{p.title}</a> : p.title}
                      {p.githubUrl && p.websiteUrl && (
                        <a class="d3-more-alt" href={p.websiteUrl} {...ext} aria-label={`${p.title} website`}><Fragment set:html={icons.link} /></a>
                      )}
                    </h3>
                    <p class="d3-more-d">{p.description}</p>
                  </li>
                );
              })}
            </ul>
          </details>
        </section>

        <section id="hackathons" class="d3-sec" aria-labelledby="d3-hack-h">
          <h2 id="d3-hack-h" class="d3-h2">Hackathons</h2>
          <ol class="d3-hk">
            {hackathons.map((h) => (
              <li class="d3-hk-row">
                <span class="d3-hk-date">{h.date}</span>
                <div class="d3-hk-body">
                  <h3 class="d3-h3">{h.event}</h3>
                  <p class="d3-hk-place">
                    {isWin(h.placement) && <Fragment set:html={icons.trophy} />}
                    <b>{h.placement}</b>
                    <span class="d3-muted"> · {h.organizer}</span>
                  </p>
                  <p class="d3-hk-proj"><span class="d3-pill">{h.project}</span>{h.prize && <span class="d3-muted"> {h.prize}</span>}</p>
                  <p class="d3-hk-blurb">{h.blurb}</p>
                  {(h.repoUrl || h.siteUrl) && (
                    <p class="d3-links">
                      {h.repoUrl && <a href={h.repoUrl} {...ext}><Fragment set:html={icons.github} /> Repository</a>}
                      {h.siteUrl && <a href={h.siteUrl} {...ext}><Fragment set:html={icons.link} /> Site</a>}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <footer class="d3-foot">
          <span>Last updated {updated}</span>
          <span class="d3-dot" aria-hidden="true">·</span>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span class="d3-dot" aria-hidden="true">·</span>
          <a class="d3-fun-link" href={FUN_HREF}>Fun mode</a>
          <span class="d3-dot" aria-hidden="true">·</span>
          <a href="#summary">Top</a>
        </footer>
      </main>
    </div>
  </div>

  <OptionSwitcher />
</ProLayout>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('d3-theme');
    function paint() {
      var dark = root.classList.contains('dark');
      if (btn) { btn.textContent = dark ? 'Light mode' : 'Dark mode'; btn.setAttribute('aria-pressed', String(dark)); }
    }
    if (btn) btn.addEventListener('click', function () {
      var dark = root.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      paint();
    });
    paint();

    var copy = document.querySelector('.d3-copy');
    if (copy) copy.addEventListener('click', function () {
      var t = copy.querySelector('.d3-copy-t');
      var text = copy.getAttribute('data-copy') || '';
      var done = function () { if (t) { t.textContent = 'Copied'; setTimeout(function () { t.textContent = 'Copy'; }, 1600); } };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, function () { location.href = 'mailto:' + text; });
      else location.href = 'mailto:' + text;
    });

    var opened = [];
    window.addEventListener('beforeprint', function () {
      opened = [];
      document.querySelectorAll('.d3 details:not([open])').forEach(function (d) { d.open = true; opened.push(d); });
    });
    window.addEventListener('afterprint', function () { opened.forEach(function (d) { d.open = false; }); opened = []; });
  })();
</script>

<style is:global>
  /* ---------- tokens ---------- */
  .d3 {
    --bg: #f6f7f9;
    --paper: #ffffff;
    --sidebar: #1f3a5f;
    --sidebar-fg: #e8eef7;
    --sidebar-muted: #a9bbd3;
    --sidebar-rule: rgba(232, 238, 247, 0.16);
    --fg: #1c2128;
    --muted: #5a6472;
    --accent: #1f3a5f;
    --accent-soft: #e6ecf5;
    --rule: #e2e6ec;
    --sans: 'Source Sans 3', system-ui, 'Segoe UI', Roboto, sans-serif;
    --serif: 'Source Serif 4', Georgia, 'Times New Roman', serif;
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.55;
    color: var(--fg);
    background: var(--bg);
    min-height: 100vh;
    padding: clamp(0.75rem, 2.5vw, 2rem) clamp(0.5rem, 2.5vw, 1.5rem) 4rem;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    box-sizing: border-box;
  }
  html.dark .d3 {
    --bg: #0f1318;
    --paper: #161b22;
    --sidebar: #0b1e33;
    --sidebar-fg: #dbe6f5;
    --sidebar-muted: #8fa5c2;
    --sidebar-rule: rgba(219, 230, 245, 0.14);
    --fg: #e6e9ee;
    --muted: #98a2b3;
    --accent: #7fa8e0;
    --accent-soft: #1b2a40;
    --rule: #262d36;
  }
  body.d3-body { margin: 0; background: #f6f7f9; color: #1c2128; }
  html.dark body.d3-body { background: #0f1318; color: #e6e9ee; }

  .d3 *, .d3 *::before, .d3 *::after { box-sizing: border-box; }
  /* base resets use :where() so they never outrank single-class component rules below */
  .d3 :where(img) { max-width: 100%; height: auto; }
  .d3 :where(svg) { flex: none; vertical-align: -0.15em; }
  .d3 :where(p, h1, h2, h3, ul, ol, dl, dd) { margin: 0; }
  .d3 :where(ul, ol) { padding: 0; list-style: none; }
  .d3 :where(a) { color: inherit; text-decoration: none; }
  .d3 :where(button) { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .d3 :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
  .d3-side :focus-visible { outline-color: var(--sidebar-fg); }
  .d3-muted { color: var(--muted); }
  .d3-dot { color: var(--muted); margin: 0 0.35rem; }

  /* ---------- sheet ---------- */
  .d3-sheet {
    max-width: 1180px;
    margin: 0 auto;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 6px;
    display: grid;
    grid-template-columns: 1fr;
    overflow: clip;
  }
  @media (min-width: 960px) {
    .d3-sheet { grid-template-columns: 300px minmax(0, 1fr); }
    .d3-side { position: sticky; top: 0; align-self: start; max-height: 100vh; overflow-y: auto; overscroll-behavior: contain; }
  }

  /* ---------- sidebar ---------- */
  .d3-side {
    background: var(--sidebar);
    color: var(--sidebar-fg);
    padding: 1.75rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    font-size: 15px;
    scrollbar-width: thin;
    scrollbar-color: var(--sidebar-muted) transparent;
  }
  .d3-side img.d3-photo {
    width: 112px; height: 112px; aspect-ratio: 1 / 1; flex: none;
    border-radius: 50%; object-fit: cover; object-position: center;
    border: 2px solid var(--sidebar-fg); display: block; margin-bottom: 1rem;
    background: var(--sidebar-muted);
  }
  .d3-name { font-family: var(--serif); font-weight: 600; font-size: 34px; line-height: 1.12; letter-spacing: -0.01em; color: var(--sidebar-fg); }
  .d3-headline { margin-top: 0.4rem; font-weight: 600; font-size: 16px; }
  .d3-tagline { margin-top: 0.2rem; color: var(--sidebar-muted); font-size: 14.5px; line-height: 1.45; }
  .d3-loc { margin-top: 0.55rem; color: var(--sidebar-muted); font-size: 14px; display: flex; align-items: center; gap: 0.35rem; }
  .d3-nav { margin-top: 0.9rem; }
  .d3-nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 0.85rem; font-size: 13.5px; }
  .d3-nav a { color: var(--sidebar-muted); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: transparent; padding: 0.15rem 0; display: inline-block; min-height: 24px; }
  .d3-nav a:hover { color: var(--sidebar-fg); text-decoration-color: currentColor; }

  .d3-side-h {
    font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700;
    color: var(--sidebar-muted); padding-bottom: 0.4rem; margin-bottom: 0.65rem;
    border-bottom: 1px solid var(--sidebar-rule);
  }
  .d3-clist { display: flex; flex-direction: column; gap: 0.3rem; }
  .d3-clist li { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .d3-clink {
    display: flex; align-items: center; gap: 0.6rem; min-width: 0; flex: 1 1 auto;
    padding: 0.3rem 0.35rem; margin-left: -0.35rem; border-radius: 4px; min-height: 40px;
  }
  .d3-clink:hover { background: rgba(255, 255, 255, 0.06); }
  .d3-ico { width: 16px; display: inline-flex; color: var(--sidebar-muted); }
  .d3-clabel { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .d3-chandle { overflow-wrap: anywhere; font-size: 14.5px; line-height: 1.3; }
  .d3-copy {
    display: inline-flex; align-items: center; gap: 0.3rem; flex: none;
    font-size: 12px; font-weight: 600; letter-spacing: 0.02em; color: var(--sidebar-fg);
    border: 1px solid var(--sidebar-rule); border-radius: 4px; padding: 0.35rem 0.5rem; min-height: 32px;
  }
  .d3-copy:hover { background: rgba(255, 255, 255, 0.08); border-color: var(--sidebar-muted); }
  .d3-avail { margin-top: 0.75rem; color: var(--sidebar-muted); font-size: 13.5px; line-height: 1.45; }

  .d3-actions { display: flex; flex-direction: column; gap: 0.5rem; }
  .d3-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    min-height: 42px; padding: 0.55rem 0.9rem; border-radius: 5px; font-weight: 600; font-size: 14.5px;
