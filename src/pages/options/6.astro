---
// src/pages/options/6.astro — Option 6 "Scan": dense recruiter dashboard.
// Fact sheet + timeline on the first screen, then compact tables with inline <details>.
// All content comes from src/lib/profile.ts; everything below is presentation.
import ProLayout from '../../layouts/ProLayout.astro';
import OptionSwitcher from '../../components/OptionSwitcher.astro';
import Icon from '../../components/pro/opt6/Icon.astro';
import {
  profile, contactLinks, sections, education,
  experience, hackathonsWithProject,
  featuredProjects, moreProjects,
  skillGroups, stats, FUN_HREF,
} from '../../lib/profile';
import type { Experience, Project } from '../../lib/profile';

// --- local derivations (presentation only) ---------------------------------
const timeline: Experience[] = [...experience].reverse(); // chronological, oldest → newest
const isCurrent = (e: Experience) => /present/i.test(e.period);
const isWin = (placement: string) => /1st|winner/i.test(placement);
const edu = education[0];
const shortDegree = edu.degree.replace('Bachelor of Science in', 'BS').replace('; Minor in', ', Minor');
const status = profile.availability.split('.')[0];
const email = contactLinks.find((l) => l.key === 'email')!;
const resume = contactLinks.find((l) => l.key === 'resume')!;
const socials = contactLinks.filter((l) => l.key === 'github' || l.key === 'linkedin' || l.key === 'x');
const updated = new Date().toLocaleString('en-US', { month: 'short', year: 'numeric' });
const LONG = 150; // descriptions longer than this get a clamp + "more" toggle
const MAX_TAGS = 4;
const skillCount = skillGroups.reduce((n, g) => n + g.all.length, 0);
const projectRows: { p: Project; featured: boolean }[] = [
  ...featuredProjects.map((p) => ({ p, featured: true })),
  ...moreProjects.map((p) => ({ p, featured: false })),
];
const primaryUrl = (p: Project) => p.websiteUrl ?? p.githubUrl;
---
<ProLayout title={`${profile.name} — ${profile.headline}`} bodyClass="opt6">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
  </Fragment>

  <a class="skip" href="#main">Skip to content</a>

  <header class="bar" id="top">
    <div class="bar__id">
      <a class="bar__name" href="#top"><span class="l">{profile.name}</span><span class="s">{profile.shortName}</span></a>
      <span class="bar__headline">{profile.headline}</span>
    </div>
    <nav class="bar__nav" aria-label="Sections">
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </nav>
    <div class="bar__actions">
      <a class="chip chip--amber chip--btn" href={FUN_HREF} title="Switch to the comic version of this site">
        <Icon name="spark" />
        <span class="l">Fun mode</span><span class="s">Fun</span>
      </a>
      <button class="chip chip--btn chip--icon" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <Icon name="sun" size={15} /><Icon name="moon" size={15} />
      </button>
      <a class="chip chip--blue chip--btn" href={resume.href} target="_blank" rel="noopener noreferrer">
        <Icon name="file" />
        Résumé<span class="l">&nbsp;PDF</span>
      </a>
    </div>
  </header>

  <main id="main" class="wrap">

    <!-- ── Fact sheet ─────────────────────────────────────────────── -->
    <section class="box fact" aria-labelledby="fact-h">
      <div class="fact__head">
        <img class="fact__photo" src={profile.photo} alt={profile.photoAlt} width="72" height="72" decoding="async" />
        <div class="fact__title">
          <h1 id="fact-h">{profile.name}</h1>
          <p class="fact__headline">{profile.headline} <span class="dot">·</span> {profile.tagline}</p>
        </div>
        <ul class="stats" aria-label="Quick stats">
          <li><strong>{stats.roles}</strong> roles</li>
          <li><strong>{stats.hackathonPlacements}</strong> hackathon placements <span class="muted">({stats.hackathonWins} wins)</span></li>
          <li><strong>{stats.projects}</strong> projects</li>
        </ul>
      </div>

      <dl class="kv">
        <div><dt>Degree</dt><dd>{shortDegree}</dd></div>
        <div><dt>School</dt><dd>{edu.url ? <a href={edu.url} target="_blank" rel="noopener noreferrer">{edu.institution}</a> : edu.institution}</dd></div>
        <div><dt>Graduation</dt><dd class="mono">{stats.graduation}</dd></div>
        <div><dt>Location</dt><dd>{profile.location}</dd></div>
        <div><dt>Status</dt><dd><span class="live" aria-hidden="true"></span>{status}</dd></div>
        <div><dt>Currently</dt><dd>{stats.currentRoles.map((e, i) => <>{i > 0 && <span class="dot">·</span>}{e.company.replace(', College of Engineering', '')}</>)}</dd></div>
        <div>
          <dt>Email</dt>
          <dd class="kv__email">
            <a class="mono" href={email.href}>{email.handle}</a>
            <button class="copy" type="button" data-copy={profile.email} aria-label={`Copy ${profile.email} to clipboard`}>Copy</button>
          </dd>
        </div>
        <div>
          <dt>Links</dt>
          <dd class="kv__links">
            {socials.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer" title={l.handle}>{l.label}</a>)}
            <a href={resume.href} target="_blank" rel="noopener noreferrer">Résumé</a>
          </dd>
        </div>
      </dl>

      <p class="fact__summary">{profile.summary}</p>
    </section>

    <!-- ── Experience ─────────────────────────────────────────────── -->
    <section class="box" id="experience" aria-labelledby="experience-h">
      <div class="box__head">
        <h2 id="experience-h">Experience <span class="count">{experience.length}</span></h2>
        <p class="box__hint">Timeline is chronological. Expand <em>Details</em> for bullets.</p>
      </div>

      <ol class="tl" role="list" aria-label="Career timeline">
        {timeline.map((e) => (
          <li class:list={['tl__item', { 'is-current': isCurrent(e) }]}>
            <span class="tl__period mono">{e.period}</span>
            <span class="tl__co">{e.company}</span>
            <span class="tl__role">{e.role}</span>
            {e.badge && <span class="pill pill--amber">{e.badge}</span>}
          </li>
        ))}
      </ol>

      <div class="scroller">
        <table class="tbl tbl--md">
          <caption class="sr-only">Roles, most recent first, with type, location and details</caption>
          <thead>
            <tr><th scope="col">Period</th><th scope="col">Company / Role</th><th scope="col">Type</th><th scope="col">Location</th><th scope="col">Details</th></tr>
          </thead>
          <tbody>
            {experience.map((e) => (
              <tr class:list={{ 'is-current': isCurrent(e) }}>
                <td class="mono nowrap" data-label="Period">{isCurrent(e) && <span class="live" aria-hidden="true"></span>}{e.period}</td>
                <th scope="row" class="cell-title">
                  <h3>{e.url ? <a href={e.url} target="_blank" rel="noopener noreferrer">{e.company}</a> : e.company}{e.badge && <span class="pill pill--amber">{e.badge}</span>}</h3>
                  <span class="sub">{e.role}</span>
                </th>
                <td data-label="Type"><span class="pill">{e.kind}</span></td>
                <td data-label="Location">{e.location ?? '—'}</td>
                <td class="cell-details" data-label="Details">
                  <details>
                    <summary>{e.bullets.length} bullets</summary>
                    <ul class="bullets">{e.bullets.map((b) => <li>{b}</li>)}</ul>
                  </details>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Projects ───────────────────────────────────────────────── -->
    <section class="box" id="projects" aria-labelledby="projects-h">
      <div class="box__head">
        <h2 id="projects-h">Projects <span class="count">{projectRows.length}</span></h2>
        <p class="box__hint">{featuredProjects.length} featured, then everything else. Hackathon builds are listed under Hackathons.</p>
      </div>
      <div class="scroller">
        <table class="tbl tbl--sm tbl--projects">
          <caption class="sr-only">Projects with stack, summary and links</caption>
          <thead>
            <tr><th scope="col">Title</th><th scope="col">Stack</th><th scope="col">Summary</th><th scope="col">Links</th></tr>
          </thead>
          <tbody>
            {projectRows.slice(0, featuredProjects.length).map(({ p }) => (
              <tr>
                <th scope="row" class="cell-title"><h3>{primaryUrl(p) ? <a href={primaryUrl(p)} target="_blank" rel="noopener noreferrer">{p.title}</a> : p.title}<span class="pill pill--blue">Featured</span></h3></th>
                <td data-label="Stack"><span class="tags">{p.tags.slice(0, MAX_TAGS).map((t) => <span class="tag">{t}</span>)}{p.tags.length > MAX_TAGS && <span class="tag tag--more" title={p.tags.slice(MAX_TAGS).join(', ')}>+{p.tags.length - MAX_TAGS}</span>}</span></td>
                <td class="cell-summary" data-label="Summary">{p.description.length > LONG ? <details class="clampd"><summary><span class="clampd__text">{p.description}</span><span class="clampd__hint" aria-hidden="true">more</span></summary></details> : <p>{p.description}</p>}</td>
                <td class="cell-links" data-label="Links">
                  {p.githubUrl && <a href={p.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} on GitHub`}><Icon name="github" />GitHub</a>}
                  {p.websiteUrl && <a href={p.websiteUrl} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} website`}><Icon name="external" />Site</a>}
                </td>
              </tr>
            ))}
          </tbody>
          <tbody>
            <tr class="tbl__group"><th scope="colgroup" colspan="4">Other projects <span class="count">{moreProjects.length}</span></th></tr>
            {projectRows.slice(featuredProjects.length).map(({ p }) => (
              <tr>
                <th scope="row" class="cell-title"><h3>{primaryUrl(p) ? <a href={primaryUrl(p)} target="_blank" rel="noopener noreferrer">{p.title}</a> : p.title}</h3></th>
                <td data-label="Stack"><span class="tags">{p.tags.slice(0, MAX_TAGS).map((t) => <span class="tag">{t}</span>)}{p.tags.length > MAX_TAGS && <span class="tag tag--more" title={p.tags.slice(MAX_TAGS).join(', ')}>+{p.tags.length - MAX_TAGS}</span>}</span></td>
                <td class="cell-summary" data-label="Summary">{p.description.length > LONG ? <details class="clampd"><summary><span class="clampd__text">{p.description}</span><span class="clampd__hint" aria-hidden="true">more</span></summary></details> : <p>{p.description}</p>}</td>
                <td class="cell-links" data-label="Links">
                  {p.githubUrl && <a href={p.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} on GitHub`}><Icon name="github" />GitHub</a>}
                  {p.websiteUrl && <a href={p.websiteUrl} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} website`}><Icon name="external" />Site</a>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Hackathons ─────────────────────────────────────────────── -->
    <section class="box" id="hackathons" aria-labelledby="hackathons-h">
      <div class="box__head">
        <h2 id="hackathons-h">Hackathons <span class="count">{hackathonsWithProject.length}</span></h2>
        <p class="box__hint">{stats.hackathonWins} first-place or track wins in the last year.</p>
      </div>
      <div class="scroller">
        <table class="tbl tbl--sm tbl--hack">
          <caption class="sr-only">Hackathon results with placement, project and links</caption>
          <thead>
            <tr><th scope="col">Date</th><th scope="col">Event</th><th scope="col">Placement</th><th scope="col">Project</th><th scope="col">Links</th></tr>
          </thead>
          <tbody>
            {hackathonsWithProject.map((h) => (
              <tr>
                <td class="mono nowrap" data-label="Date">{h.date}</td>
                <th scope="row" class="cell-title"><h3>{h.event}</h3><span class="sub">{h.organizer}</span></th>
                <td data-label="Placement">
                  <span class:list={['pill', isWin(h.placement) ? 'pill--green' : 'pill--amber']}>{h.placement}</span>
                  {h.prize && <span class="sub">{h.prize}</span>}
                </td>
                <td class="cell-summary" data-label="Project">
                  <details class="rowd">
                    <summary><strong>{h.project}</strong>{h.projectEntry && <span class="sub sub--inline">{h.projectEntry.tags.slice(0, 3).join(', ')}</span>}<span class="rowd__hint" aria-hidden="true">what it does</span></summary>
                    <p>{h.blurb}</p>
                  </details>
                </td>
                <td class="cell-links" data-label="Links">
                  {h.repoUrl && <a href={h.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={`${h.project} repository`}><Icon name="github" />Repo</a>}
                  {h.siteUrl && <a href={h.siteUrl} target="_blank" rel="noopener noreferrer" aria-label={`${h.project} website`}><Icon name="external" />Site</a>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Skills + Education / Contact ───────────────────────────── -->
    <div class="grid2">
      <section class="box" id="skills" aria-labelledby="skills-h">
        <div class="box__head">
          <h2 id="skills-h">Skills <span class="count">{skillCount}</span></h2>
          <p class="box__hint"><span class="tag tag--hi">highlighted</span> = primary</p>
        </div>
        <table class="tbl tbl--skills">
          <caption class="sr-only">Skills by category; highlighted entries are primary</caption>
          <thead class="sr-only"><tr><th scope="col">Category</th><th scope="col">Skills</th></tr></thead>
          <tbody>
            {skillGroups.map((g) => (
              <tr>
                <th scope="row"><span class="skills__label">{g.label}</span><span class="skills__n mono">{g.all.length}</span></th>
                <td><span class="tags">{g.all.map((s) => <span class:list={['tag', { 'tag--hi': g.featured.includes(s) }]}>{s}</span>)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <div class="stack">
        <section class="box" id="education" aria-labelledby="education-h">
          <div class="box__head"><h2 id="education-h">Education</h2></div>
          <h3 class="edu__degree">{edu.degree}</h3>
          <p class="edu__school">{edu.url ? <a href={edu.url} target="_blank" rel="noopener noreferrer">{edu.institution}</a> : edu.institution}</p>
          <p class="mono muted">{edu.period} <span class="dot">·</span> {edu.location}</p>
        </section>

        <section class="box" id="contact" aria-labelledby="contact-h">
          <div class="box__head"><h2 id="contact-h">Contact</h2></div>
          <ul class="contacts" role="list">
            {contactLinks.map((l) => (
              <li>
                <span class="contacts__label">{l.label}</span>
                <a class="mono" href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>{l.handle}</a>
                {l.key === 'email' && <button class="copy" type="button" data-copy={profile.email} aria-label={`Copy ${profile.email} to clipboard`}>Copy</button>}
              </li>
            ))}
          </ul>
          <p class="contact__note">{profile.availability}</p>
          <p class="contact__fun">Prefer something less spreadsheet-shaped? <a href={FUN_HREF}>Fun mode</a>.</p>
        </section>
      </div>
    </div>

    <footer class="foot">
      <span>Updated {updated}</span><span class="dot">·</span>
      <a href={FUN_HREF}>Fun mode</a><span class="dot">·</span>
      <a href="#top">Top</a>
    </footer>
  </main>

  <OptionSwitcher />
</ProLayout>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var t = document.getElementById('theme-toggle');
    if (t) {
      t.setAttribute('aria-pressed', String(root.classList.contains('dark')));
      t.addEventListener('click', function () {
        var dark = root.classList.toggle('dark');
        t.setAttribute('aria-pressed', String(dark));
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      });
    }
    var copies = document.querySelectorAll('[data-copy]');
    for (var i = 0; i < copies.length; i++) (function (b) {
      b.addEventListener('click', function () {
        var v = b.getAttribute('data-copy'), label = b.textContent;
        var done = function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = label; }, 1500); };
        var fallback = function () { location.href = 'mailto:' + v; };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(v).then(done, fallback);
        else fallback();
      });
    })(copies[i]);
  })();
</script>

<style>
  /* ── tokens ─────────────────────────────────────────────────────── */
  :global(body.opt6) {
    --bg: #f5f7fa; --panel: #ffffff; --fg: #111827; --muted: #5b6472;
    --border: #e5e7eb; --border-strong: #cbd5e1;
    --blue: #1d4ed8; --blue-soft: #dbeafe;
    --green: #047857; --green-soft: #d1fae5;
    --amber: #92400e; --amber-soft: #fef3c7;
    --row-alt: #f9fafb; --focus: #1d4ed8;
    --sans: 'IBM Plex Sans', system-ui, 'Segoe UI', Roboto, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;
    margin: 0; background: var(--bg); color: var(--fg);
    font: 400 14.5px/1.5 var(--sans);
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  :global(html.dark body.opt6) {
    --bg: #0b0f17; --panel: #111827; --fg: #e5e7eb; --muted: #9ca3af;
    --border: #1f2937; --border-strong: #374151;
    --blue: #93b4ff; --blue-soft: #172554;
    --green: #6ee7b7; --green-soft: #064e3b;
    --amber: #fcd34d; --amber-soft: #452c05;
    --row-alt: #0f172a; --focus: #93b4ff;
  }
  :global(html) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }

  /* ── base ───────────────────────────────────────────────────────── */
  a { color: var(--blue); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 2px; }
  a:focus-visible, button:focus-visible, summary:focus-visible {
    outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 3px;
  }
  img { max-width: 100%; }
  h1, h2, h3, p, dl, dd, ul, ol { margin: 0; }
  .mono { font-family: var(--mono); font-size: 13px; }
  .muted { color: var(--muted); }
  .nowrap { white-space: nowrap; }
  .dot { color: var(--muted); margin: 0 .35em; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .skip { position: absolute; left: .75rem; top: -3rem; z-index: 2147483001; padding: .4rem .7rem; background: var(--panel); border: 1px solid var(--border-strong); border-radius: 4px; }
  .skip:focus { top: .5rem; }

  /* ── top bar ────────────────────────────────────────────────────── */
  .bar {
    position: sticky; top: 0; z-index: 50; height: 44px;
    display: flex; align-items: center; gap: 1rem;
    padding: 0 clamp(0.75rem, 2.5vw, 1.5rem);
    background: var(--panel); border-bottom: 1px solid var(--border);
  }
  .bar__id { display: flex; align-items: baseline; gap: .6rem; min-width: 0; }
  .bar__name { color: var(--fg); font-weight: 600; white-space: nowrap; }
  .bar__headline { color: var(--muted); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar__nav { display: flex; gap: .15rem; margin-left: auto; }
  .bar__nav a { font: 500 12px/1 var(--mono); color: var(--muted); padding: .55rem .5rem; border-radius: 4px; }
  .bar__nav a:hover { color: var(--fg); background: var(--bg); text-decoration: none; }
  .bar__actions { display: flex; align-items: center; gap: .4rem; flex-shrink: 0; }
  .bar__nav + .bar__actions { margin-left: 0; }
  .bar__id + .bar__actions { margin-left: auto; }
  .s { display: none; }
  @media (max-width: 899.98px) { .bar__nav { display: none; } .bar__actions { margin-left: auto; } }
  @media (max-width: 639.98px), (min-width: 900px) and (max-width: 1149.98px) { .bar__headline { display: none; } }
  @media (max-width: 479.98px) { .l { display: none; } .s { display: inline; } }

  /* ── chips / pills / tags ───────────────────────────────────────── */
  .chip {
    display: inline-flex; align-items: center; gap: .35rem; height: 30px; padding: 0 .65rem;
    border: 1px solid var(--border-strong); border-radius: 5px; background: var(--panel); color: var(--fg);
    font: 500 12.5px/1 var(--sans); cursor: pointer; white-space: nowrap;
  }
  .chip:hover { text-decoration: none; background: var(--bg); }
  .chip--icon { width: 30px; padding: 0; justify-content: center; }
  .chip--blue { background: var(--blue); border-color: var(--blue); color: #fff; }
  .chip--blue:hover { background: var(--blue); filter: brightness(1.08); }
  :global(html.dark) .chip--blue { color: #0b0f17; }
  .chip--amber { background: var(--amber-soft); border-color: transparent; color: var(--amber); }
  .chip--amber:hover { background: var(--amber-soft); filter: brightness(.97); }
  @media (pointer: coarse) { .bar { height: 48px; } .chip { height: 36px; } .chip--icon { width: 36px; } }

  .pill {
    display: inline-flex; align-items: center; height: 20px; padding: 0 .45rem; margin-left: .35rem; vertical-align: 1px;
    border: 1px solid var(--border); border-radius: 4px; background: var(--bg);
    font: 500 11.5px/1 var(--mono); letter-spacing: .01em; white-space: nowrap; color: var(--fg);
  }
  .pill--blue { background: var(--blue-soft); border-color: transparent; color: var(--blue); }
  .pill--green { background: var(--green-soft); border-color: transparent; color: var(--green); }
  .pill--amber { background: var(--amber-soft); border-color: transparent; color: var(--amber); }
  .kv .pill, .tbl td > .pill:first-child { margin-left: 0; }
  .tbl td .pill { height: auto; min-height: 20px; padding: 2px .45rem; white-space: normal; line-height: 1.25; }

  .tags { display: inline-flex; flex-wrap: wrap; gap: 3px; }
  .tag {
    display: inline-block; padding: 1px 6px; border: 1px solid var(--border); border-radius: 3px;
    font: 400 12px/1.5 var(--mono); color: var(--fg); background: var(--panel); white-space: nowrap;
  }
  .tag--hi { background: var(--blue-soft); border-color: transparent; color: var(--blue); font-weight: 500; }
  .tag--more { color: var(--muted); border-style: dashed; cursor: help; }
  .count {
    display: inline-flex; align-items: center; height: 18px; padding: 0 .4rem; margin-left: .4rem; vertical-align: 2px;
    border: 1px solid var(--border-strong); border-radius: 999px; background: var(--bg);
