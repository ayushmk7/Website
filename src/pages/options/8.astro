---
// src/pages/options/8.astro — Option 8 "Index": type-led index.
// Oversized name, one strict rule-grid, and every role / project / hackathon / skill group
// is a numbered row that opens inline (native <details>). Pure #000 on #fff, inverted in dark.
// Hierarchy from size, weight, width, tracking and 1px rules only. No colour, shadow, radius, motion.
// Content comes only from ../../lib/profile (the shared contract), never from the raw data files.
import ProLayout from '../../layouts/ProLayout.astro';
import OptionSwitcher from '../../components/OptionSwitcher.astro';
import {
  profile, contactLinks, sections, education,
  experience, hackathonsWithProject,
  featuredProjects, moreProjects, visibleProjects,
  skillGroups, stats, FUN_HREF,
} from '../../lib/profile';

const ext = { target: '_blank', rel: 'noopener noreferrer' } as const;
const pad = (n: number) => String(n).padStart(2, '0');
const isWin = (placement: string) => /1st|winner/i.test(placement);
const skillTotal = skillGroups.reduce((n, g) => n + g.all.length, 0);
const year = new Date().getFullYear();

// Name on two lines: "Ayush Madhav" / "Kumar".
const nameLine1 = profile.shortName;
const nameLine2 = profile.name.startsWith(profile.shortName) ? profile.name.slice(profile.shortName.length).trim() : '';

const sectionIndex = Object.fromEntries(sections.map((s, i) => [s.id, pad(i + 1)]));
const sectionLabel = Object.fromEntries(sections.map((s) => [s.id, s.label]));
const counts: Record<string, string> = {
  experience: `${pad(stats.roles)} roles`,
  projects: `${pad(visibleProjects.length)} projects`,
  hackathons: `${pad(stats.hackathonPlacements)} placements / ${pad(stats.hackathonWins)} wins`,
  skills: `${skillTotal} skills`,
  education: `Class of ${stats.graduation.split(' ').pop()}`,
  contact: profile.location,
};
const facts = [
  `${pad(stats.roles)} roles`,
  `${pad(stats.projects)} projects`,
  `${pad(stats.hackathonPlacements)} hackathon placements`,
  `${pad(stats.hackathonWins)} wins`,
  `Class of ${stats.graduation.split(' ').pop()}`,
];
---
<ProLayout title={`${profile.name} — ${profile.headline}`} bodyClass="idx">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </Fragment>

  <a class="skip" href="#main">Skip to content</a>

  <header class="top" id="top">
    <div class="top__in mono">
      <a class="top__brand" href="#top"><strong>{profile.initials}</strong> / Index</a>
      <details class="top__idx">
        <summary aria-label="Section index">Sections <span class="top__idx-glyph" aria-hidden="true"></span></summary>
        <nav aria-label="Sections">
          <ol>
            {sections.map((s, i) => (
              <li><a href={`#${s.id}`}><span class="top__no">{pad(i + 1)}</span> {s.label}</a></li>
            ))}
          </ol>
        </nav>
      </details>
      <nav class="top__nav" aria-label="Sections">
        <ol>
          {sections.map((s, i) => (
            <li><a href={`#${s.id}`}><span class="top__no">{pad(i + 1)}</span> {s.label}</a></li>
          ))}
        </ol>
      </nav>
      <nav class="top__tools" aria-label="Site">
        <a class="top__fun" href={FUN_HREF} title="Switch to the comic version of this site">Fun mode <span aria-hidden="true">↗</span></a>
        <button class="top__theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
          <span class="when-light">Dark</span><span class="when-dark">Light</span>
        </button>
      </nav>
    </div>
  </header>

  <main class="page" id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-name">
      <h1 id="hero-name" class="name">
        <span class="name__line">{nameLine1}</span>
        {nameLine2 && <span class="name__line">{nameLine2}</span>}
      </h1>
      <div class="front">
        <div class="front__id">
          <p class="front__headline">{profile.headline}</p>
          <p class="front__tagline">{profile.tagline}</p>
          <p class="mono mute front__loc">{profile.location}</p>
        </div>
        <p class="front__summary">{profile.summary}</p>
        <ul class="front__links mono" aria-label="Contact links">
          {contactLinks.map((l) => (
            <li>
              {l.external
                ? <a href={l.href} {...ext}>{l.label}{l.key === 'resume' ? ' (PDF)' : ''} <span aria-hidden="true">↗</span></a>
                : <a href={l.href}>{l.label} <span aria-hidden="true">→</span></a>}
              {l.key === 'email' && (
                <button type="button" class="copy" data-copy={profile.email} aria-label={`Copy email address ${profile.email}`}>[copy]</button>
              )}
            </li>
          ))}
        </ul>
      </div>
      <p class="facts mono" aria-label="Quick facts">
        {facts.map((f, i) => <span>{i > 0 && <span class="facts__sep" aria-hidden="true"> / </span>}{f}</span>)}
      </p>
    </section>

    <!-- 01 Experience -->
    <section id="experience" aria-labelledby="h-experience">
      <div class="sec">
        <span class="sec__no mono" aria-hidden="true">{sectionIndex.experience}</span>
        <h2 id="h-experience">{sectionLabel.experience}</h2>
        <div class="sec__meta mono">
          <span class="mute">{counts.experience}</span>
          <button type="button" class="expand" data-expand-all>Expand all</button>
        </div>
      </div>
      <ol class="rows">
        {experience.map((e, i) => (
          <li>
            <details class="row">
              <summary>
                <h3 class="grid">
                  <span class="no mono">{pad(i + 1)}</span>
                  <span class="ttl">
                    <span class="ttl__main">{e.role}</span>
                    <span class="ttl__sub">{e.company}{e.badge && <span class="mono badge"> [{e.badge}]</span>}</span>
                  </span>
                  <span class="meta mono">
                    <span>{e.period}</span>
                    <span class="mute">{e.kind}</span>
                  </span>
                </h3>
              </summary>
              <div class="body">
                <ul class="bullets">
                  {e.bullets.map((b) => <li>{b}</li>)}
                </ul>
                <p class="body__foot mono mute">
                  {e.location && <span>{e.location}</span>}
                  {e.url && <a href={e.url} {...ext}>{e.company} <span aria-hidden="true">↗</span></a>}
                </p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <!-- 02 Projects -->
    <section id="projects" aria-labelledby="h-projects">
      <div class="sec">
        <span class="sec__no mono" aria-hidden="true">{sectionIndex.projects}</span>
        <h2 id="h-projects">{sectionLabel.projects}</h2>
        <div class="sec__meta mono">
          <span class="mute">{counts.projects}</span>
          <button type="button" class="expand" data-expand-all>Expand all</button>
        </div>
      </div>
      <ol class="rows">
        {featuredProjects.map((p, i) => (
          <li>
            <details class="row">
              <summary>
                <h3 class="grid">
                  <span class="no mono">{pad(i + 1)}</span>
                  <span class="ttl">
                    <span class="ttl__main">{p.title}</span>
                    <span class="ttl__sub mute">Featured</span>
                  </span>
                  <span class="meta mono">
                    {p.tags.slice(0, 2).map((t) => <span>{t}</span>)}
                  </span>
                </h3>
              </summary>
              <div class="body">
                <p class="desc">{p.description}</p>
                <p class="mono mute tags">{p.tags.join(' / ')}</p>
                {(p.githubUrl || p.websiteUrl) && (
                  <p class="links mono">
                    {p.githubUrl && <a href={p.githubUrl} {...ext}>GitHub <span aria-hidden="true">↗</span></a>}
                    {p.websiteUrl && <a href={p.websiteUrl} {...ext}>Site <span aria-hidden="true">↗</span></a>}
                  </p>
                )}
              </div>
            </details>
          </li>
        ))}
      </ol>
      <details class="more">
        <summary class="grid mono">
          <span class="no" aria-hidden="true"><span class="more__open">+</span><span class="more__close">–</span></span>
          <span class="ttl"><span class="more__open">Show {moreProjects.length} more projects</span><span class="more__close">Hide {moreProjects.length} projects</span></span>
          <span class="meta mute">{pad(featuredProjects.length + 1)}–{pad(visibleProjects.length)}</span>
        </summary>
        <ol class="rows" start={featuredProjects.length + 1}>
          {moreProjects.map((p, i) => (
            <li>
              <details class="row">
                <summary>
                  <h3 class="grid">
                    <span class="no mono">{pad(featuredProjects.length + i + 1)}</span>
                    <span class="ttl"><span class="ttl__main">{p.title}</span></span>
                    <span class="meta mono">
                      {p.tags.slice(0, 2).map((t) => <span>{t}</span>)}
                    </span>
                  </h3>
                </summary>
                <div class="body">
                  <p class="desc">{p.description}</p>
                  <p class="mono mute tags">{p.tags.join(' / ')}</p>
                  {(p.githubUrl || p.websiteUrl) && (
                    <p class="links mono">
                      {p.githubUrl && <a href={p.githubUrl} {...ext}>GitHub <span aria-hidden="true">↗</span></a>}
                      {p.websiteUrl && <a href={p.websiteUrl} {...ext}>Site <span aria-hidden="true">↗</span></a>}
                    </p>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ol>
      </details>
    </section>

    <!-- 03 Hackathons -->
    <section id="hackathons" aria-labelledby="h-hackathons">
      <div class="sec">
        <span class="sec__no mono" aria-hidden="true">{sectionIndex.hackathons}</span>
        <h2 id="h-hackathons">{sectionLabel.hackathons}</h2>
        <div class="sec__meta mono">
          <span class="mute">{counts.hackathons}</span>
          <button type="button" class="expand" data-expand-all>Expand all</button>
        </div>
      </div>
      <ol class="rows">
        {hackathonsWithProject.map((h, i) => (
          <li>
            <details class="row">
              <summary>
                <h3 class="grid">
                  <span class="no mono">{pad(i + 1)}{isWin(h.placement) && <span class="star" title="Win" aria-label="win">★</span>}</span>
                  <span class="ttl">
                    <span class="ttl__main">{h.event}</span>
                    <span class="ttl__sub"><strong>{h.placement}</strong>{h.prize && <span class="mute"> · {h.prize}</span>}</span>
                  </span>
                  <span class="meta mono">
                    <span>{h.date}</span>
                    <span class="mute">{h.organizer}</span>
                  </span>
                </h3>
              </summary>
              <div class="body">
                <p class="body__kicker mono">Project: {h.project}</p>
                <p class="desc">{h.blurb}</p>
                {h.projectEntry?.tags?.length ? <p class="mono mute tags">{h.projectEntry.tags.join(' / ')}</p> : null}
                {(h.repoUrl || h.siteUrl) && (
                  <p class="links mono">
                    {h.repoUrl && <a href={h.repoUrl} {...ext}>Repository <span aria-hidden="true">↗</span></a>}
                    {h.siteUrl && <a href={h.siteUrl} {...ext}>Site <span aria-hidden="true">↗</span></a>}
                  </p>
                )}
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <!-- 04 Skills -->
    <section id="skills" aria-labelledby="h-skills">
      <div class="sec">
        <span class="sec__no mono" aria-hidden="true">{sectionIndex.skills}</span>
        <h2 id="h-skills">{sectionLabel.skills}</h2>
        <div class="sec__meta mono">
          <span class="mute">{counts.skills}</span>
          <button type="button" class="expand" data-expand-all>Expand all</button>
        </div>
      </div>
      <ol class="rows">
        {skillGroups.map((g, i) => (
          <li>
            <details class="row">
              <summary>
                <h3 class="grid">
                  <span class="no mono">{pad(i + 1)}</span>
                  <span class="ttl">
                    <span class="ttl__main">{g.label}</span>
                    <span class="ttl__sub mono">{g.featured.join(' / ')}</span>
                  </span>
                  <span class="meta mono">
                    <span class="mute">{g.all.length} total</span>
                  </span>
                </h3>
              </summary>
              <div class="body">
                <p class="desc">{g.all.join(', ')}</p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <!-- 05 Education -->
    <section id="education" aria-labelledby="h-education">
      <div class="sec">
        <span class="sec__no mono" aria-hidden="true">{sectionIndex.education}</span>
        <h2 id="h-education">{sectionLabel.education}</h2>
        <div class="sec__meta mono"><span class="mute">{counts.education}</span></div>
      </div>
      <ul class="rows">
        {education.map((ed, i) => (
          <li class="row row--static">
            <h3 class="grid">
              <span class="no mono">{pad(i + 1)}</span>
              <span class="ttl">
                <span class="ttl__main">{ed.degree}</span>
                <span class="ttl__sub">
                  {ed.url ? <a href={ed.url} {...ext}>{ed.institution} <span aria-hidden="true">↗</span></a> : ed.institution}
                </span>
              </span>
              <span class="meta mono">
                <span>{ed.period}</span>
                <span class="mute">{ed.location}</span>
              </span>
            </h3>
          </li>
        ))}
      </ul>
    </section>

    <!-- 06 Contact -->
    <section id="contact" aria-labelledby="h-contact">
      <div class="sec">
        <span class="sec__no mono" aria-hidden="true">{sectionIndex.contact}</span>
        <h2 id="h-contact">{sectionLabel.contact}</h2>
        <div class="sec__meta mono"><span class="mute">{counts.contact}</span></div>
      </div>
      <p class="avail">{profile.availability}</p>
      <ul class="rows" aria-label="Contact links">
        {contactLinks.map((l, i) => (
          <li class="row row--static row--link">
            <div class="grid">
              <span class="no mono">{pad(i + 1)}</span>
              <span class="ttl">
                {l.external
                  ? <a class="ttl__main stretch" href={l.href} {...ext}>{l.label}{l.key === 'resume' ? ' (PDF)' : ''}</a>
                  : <a class="ttl__main stretch" href={l.href}>{l.label}</a>}
                <span class="ttl__sub mono">{l.handle}</span>
              </span>
              <span class="meta mono">
                {l.key === 'email' && (
                  <button type="button" class="copy copy--row" data-copy={profile.email} aria-label={`Copy email address ${profile.email}`}>[copy]</button>
                )}
                <span aria-hidden="true">{l.external ? '↗' : '→'}</span>
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <footer class="foot mono">
      <p>© {year} {profile.name}</p>
      <p>
        <a href={FUN_HREF}>Fun mode <span aria-hidden="true">↗</span></a>
        <span aria-hidden="true"> / </span>
        <a href="#top">Top <span aria-hidden="true">↑</span></a>
      </p>
      <p class="mute">Set in Archivo and IBM Plex Mono</p>
    </footer>
  </main>

  <OptionSwitcher />
</ProLayout>

<style>
  /* ---------- tokens ---------- */
  :global(body.idx) {
    --bg: #ffffff;
    --fg: #000000;
    --mute: #595959;      /* 7.0:1 on white */
    --gut: clamp(16px, 4vw, 56px);
    --no-w: 3.5rem;
    --meta-w: 22rem;
    --top-h: 44px;
    --sans: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color-scheme: light;
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  :global(html.dark body.idx) {
    --bg: #000000;
    --fg: #ffffff;
    --mute: #a3a3a3;      /* 9.6:1 on black */
    color-scheme: dark;
  }
  :global(html) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }

  /* ---------- resets (low specificity) ---------- */
  :where(a) { color: inherit; text-decoration: none; }
  :where(button) { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  :where(p, h1, h2, h3, ul, ol) { margin: 0; padding: 0; }
  :where(ul, ol) { list-style: none; }
  :where(summary) { list-style: none; cursor: pointer; }
  :where(summary)::-webkit-details-marker { display: none; }
  :where(img) { max-width: 100%; }

  .mono { font-family: var(--mono); font-size: 12.5px; line-height: 1.5; font-variant-numeric: tabular-nums; letter-spacing: 0.01em; }
  .mute { color: var(--mute); }

  a:focus-visible, button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  summary:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  a:hover { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }

  .skip {
    position: absolute; left: var(--gut); top: -3rem; z-index: 10;
    padding: 0.4rem 0.7rem; background: var(--fg); color: var(--bg); font-family: var(--mono); font-size: 12.5px;
  }
  .skip:focus { top: 0.5rem; }

  /* ---------- top strip ---------- */
  .top { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--fg); }
  .top__in {
    max-width: 1600px; margin: 0 auto; padding: 0 var(--gut);
    display: flex; flex-wrap: wrap; align-items: center; gap: 0 1.5rem;
    min-height: var(--top-h); text-transform: uppercase; letter-spacing: 0.06em;
  }
  .top__brand { white-space: nowrap; display: inline-flex; align-items: center; min-height: var(--top-h); }
  .top__brand strong { font-weight: 500; margin-right: 0.4em; }
  .top__nav { margin-right: auto; }
  .top__nav ol { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  .top__nav a { display: inline-flex; align-items: center; min-height: var(--top-h); white-space: nowrap; }
  .top__no { color: var(--mute); margin-right: 0.45em; }
  .top__tools { display: flex; align-items: center; gap: 1.25rem; margin-left: auto; }
  .top__fun, .top__theme { display: inline-flex; align-items: center; min-height: var(--top-h); white-space: nowrap; text-transform: inherit; letter-spacing: inherit; }
  .top__theme:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .when-dark { display: none; }
  :global(html.dark) .when-light { display: none; }
  :global(html.dark) .when-dark { display: inline; }
  /* mobile: one-line sticky bar; section links live in a native <details> disclosure */
  .top__idx { display: none; }
  @media (max-width: 999px) {
    .top__nav { display: none; }
    .top__in { flex-wrap: nowrap; gap: 0 0.9rem; }
    .top__tools { gap: 0.9rem; }
    .top__idx { display: block; }
    .top__idx > summary { display: inline-flex; align-items: center; min-height: var(--top-h); white-space: nowrap; }
    .top__idx > summary:hover { text-decoration: underline; text-underline-offset: 0.2em; }
    .top__idx > summary:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
    .top__idx-glyph::before { content: '+'; margin-left: 0.4em; }
    .top__idx[open] .top__idx-glyph::before { content: '–'; }
    .top__idx ol {
      position: absolute; left: 0; right: 0; top: 100%;
      background: var(--bg); border-top: 1px solid var(--fg); border-bottom: 1px solid var(--fg);
      padding: 0 var(--gut);
    }
    .top__idx li + li { border-top: 1px solid var(--fg); }
    .top__idx a { display: flex; align-items: center; min-height: 44px; }
    .top__idx a:focus-visible { outline-offset: -2px; }
  }

  /* ---------- page ---------- */
  .page { max-width: 1600px; margin: 0 auto; padding: 0 var(--gut) 3rem; }
  section { scroll-margin-top: calc(var(--top-h) + 1rem); }

  /* hero */
  .hero { padding: clamp(2rem, 5vw, 4.5rem) 0 clamp(2rem, 4vw, 3.5rem); }
  .name {
    font-size: clamp(3rem, 11.5vw, 10.5rem);
    font-weight: 600;
    font-stretch: 110%;
    line-height: 0.88;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }
  .name__line { display: block; }
  .front {
    margin-top: clamp(2rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--fg);
    display: grid; gap: 1.5rem var(--gut);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 760px) { .front { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 0.9fr); } }
  .front__headline { font-size: 17px; font-weight: 500; letter-spacing: -0.01em; }
  .front__tagline { margin-top: 0.35rem; max-width: 30ch; }
  .front__loc { margin-top: 0.85rem; }
  .front__summary { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.45; max-width: 62ch; letter-spacing: -0.005em; }
  .front__links li { display: flex; align-items: center; gap: 0.5rem; min-height: 32px; }
  .front__links a { display: inline-flex; align-items: center; min-height: 32px; }
  .copy { color: var(--mute); display: inline-flex; align-items: center; min-height: 32px; }
  .copy:hover { color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
  .copy[data-done] { color: inherit; font-weight: 500; }
  .facts { margin-top: 2rem; padding-top: 0.75rem; border-top: 1px solid var(--fg); text-transform: uppercase; letter-spacing: 0.06em; }
  .facts__sep { color: var(--mute); }

  /* section head */
  section { padding-top: clamp(2.5rem, 5vw, 4.5rem); }
  .sec {
    display: grid; align-items: end; gap: 0.5rem var(--gut);
    grid-template-columns: var(--no-w) minmax(0, 1fr);
    padding-bottom: 0.75rem; border-bottom: 2px solid var(--fg);
  }
  @media (min-width: 760px) { .sec { grid-template-columns: var(--no-w) minmax(0, 1fr) minmax(0, var(--meta-w)); } }
  .sec__no { align-self: end; padding-bottom: 0.35em; }
  .sec h2 { font-size: clamp(1.75rem, 4.2vw, 3.25rem); font-weight: 500; line-height: 1; letter-spacing: -0.03em; }
  .sec__meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; align-items: center; text-transform: uppercase; letter-spacing: 0.06em; }
  @media (min-width: 760px) { .sec__meta { justify-content: flex-end; text-align: right; } }
  @media (max-width: 759px) { .sec__meta { grid-column: 2; } }
  .expand { text-transform: inherit; letter-spacing: inherit; min-height: 40px; display: inline-flex; align-items: center; }
  .expand:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .expand::before { content: '+ '; }
  .expand[data-open]::before { content: '– '; }

  /* rows */
  .rows { border-bottom: 1px solid var(--fg); }
  .rows > li + li { border-top: 1px solid var(--fg); }
  .grid {
    display: grid; column-gap: var(--gut); row-gap: 0.25rem; align-items: baseline;
    grid-template-columns: var(--no-w) minmax(0, 1fr);
    grid-template-areas: 'no ttl' '. meta';
    padding: 0.95rem 0; min-height: 48px;
    font-size: inherit; font-weight: inherit; line-height: inherit;
  }
  @media (min-width: 760px) {
    .grid { grid-template-columns: var(--no-w) minmax(0, 1fr) minmax(0, var(--meta-w)); grid-template-areas: 'no ttl meta'; }
  }
  .no { grid-area: no; color: var(--mute); display: inline-flex; gap: 0.35em; align-items: baseline; }
  .star { color: var(--fg); font-family: var(--sans); font-size: 11px; }
  .ttl { grid-area: ttl; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .ttl__main { font-size: clamp(1.05rem, 1.6vw, 1.35rem); font-weight: 500; line-height: 1.25; letter-spacing: -0.015em; overflow-wrap: anywhere; }
  .ttl__sub { font-size: 15px; line-height: 1.4; overflow-wrap: anywhere; }
  .ttl__sub.mono { font-size: 12.5px; }
  .badge { font-size: 12px; color: var(--mute); }
  .meta { grid-area: meta; display: flex; flex-wrap: wrap; gap: 0 1rem; min-width: 0; overflow-wrap: anywhere; }
  @media (min-width: 760px) { .meta { flex-direction: column; align-items: flex-end; text-align: right; gap: 0.1rem; } }

  /* row states: hover / open invert */
  .row > summary { display: block; }
  .row > summary:hover, .row--static:hover { background: var(--fg); color: var(--bg); --mute: var(--bg); }
  .row > summary:hover .star { color: var(--bg); }
  .row[open] > summary .no::after { content: '–'; }
  .row:not([open]) > summary .no::after { content: '+'; }
  .row > summary .no::after { margin-left: 0.1em; }
  .row--static .grid { padding: 1.1rem 0; }
  .row--link { position: relative; }
  .stretch::after { content: ''; position: absolute; inset: 0; }
  .row--link .copy--row { position: relative; z-index: 1; }
  .row--link .meta { flex-direction: row; align-items: center; gap: 1rem; }
  @media (min-width: 760px) { .row--link .meta { justify-content: flex-end; } }
  .row--link:hover a { text-decoration: none; }
  .row--link:focus-within { outline: 2px solid currentColor; outline-offset: -2px; }
  .row--link a:focus-visible { outline: none; }

  .body { padding: 0.25rem 0 1.6rem var(--no-w); max-width: calc(var(--no-w) + 72ch); }
  @media (min-width: 760px) { .body { padding-left: calc(var(--no-w) + var(--gut)); max-width: calc(var(--no-w) + var(--gut) + 72ch); } }
  .bullets li { position: relative; padding-left: 1.4rem; }
  .bullets li + li { margin-top: 0.55rem; }
  .bullets li::before { content: '—'; position: absolute; left: 0; color: var(--mute); }
  .body__foot { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  .body__kicker { margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .desc { font-size: 16px; }
  .tags { margin-top: 0.6rem; }
  .links { margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .links a, .body__foot a { display: inline-flex; align-items: center; min-height: 32px; }

  /* "more projects" wrapper */
  .more { border-bottom: 1px solid var(--fg); }
  .more > summary { text-transform: uppercase; letter-spacing: 0.06em; }
  .more > summary:hover { background: var(--fg); color: var(--bg); --mute: var(--bg); }
  .more > summary .grid { padding: 0.85rem 0; align-items: center; }
  .more > summary .no { color: inherit; }
  .more__close { display: none; }
  .more[open] > summary .more__open { display: none; }
  .more[open] > summary .more__close { display: inline; }
  .more[open] > summary { border-bottom: 1px solid var(--fg); }
  .more > .rows { border-bottom: 0; }
  .more > .rows > li:first-child { border-top: 0; }

  /* contact */
  .avail { padding: 1.5rem 0 1.25rem; font-size: clamp(1.25rem, 2.6vw, 2rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; max-width: 30ch; }

  /* footer */
  .foot {
    margin-top: clamp(3rem, 6vw, 5rem); padding-top: 0.9rem; border-top: 1px solid var(--fg);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .foot a { display: inline-flex; align-items: center; min-height: 32px; }

  @media print {
    .top, .foot, .copy, .expand, :global(.opt-switch) { display: none !important; }
    .rows, .grid { break-inside: avoid; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.querySelector('[data-theme-toggle]');
    function syncLabel() {
      if (btn) btn.setAttribute('aria-label', root.classList.contains('dark') ? 'Switch to light theme' : 'Switch to dark theme');
    }
    syncLabel();
    if (btn) btn.addEventListener('click', function () {
      var dark = root.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      syncLabel();
    });

    Array.prototype.forEach.call(document.querySelectorAll('[data-copy]'), function (b) {
      b.addEventListener('click', function () {
        var email = b.getAttribute('data-copy');
        var done = function () {
          b.textContent = '[copied]';
          b.setAttribute('data-done', '');
          setTimeout(function () { b.textContent = '[copy]'; b.removeAttribute('data-done'); }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).then(done, function () { location.href = 'mailto:' + email; });
        } else {
          location.href = 'mailto:' + email;
        }
      });
    });

    Array.prototype.forEach.call(document.querySelectorAll('[data-expand-all]'), function (b) {
      var sec = b.closest('section');
      var rows = sec ? sec.querySelectorAll('details.row') : [];
      var sync = function () {
        var allOpen = rows.length > 0 && Array.prototype.every.call(rows, function (d) { return d.open; });
        b.textContent = allOpen ? 'Collapse all' : 'Expand all';
        if (allOpen) b.setAttribute('data-open', ''); else b.removeAttribute('data-open');
      };
      b.addEventListener('click', function () {
        var open = !b.hasAttribute('data-open');
        Array.prototype.forEach.call(rows, function (d) { d.open = open; });
        var more = sec && sec.querySelector('details.more');
        if (more && open) more.open = true;
        sync();
      });
      Array.prototype.forEach.call(rows, function (d) { d.addEventListener('toggle', sync); });
      sync();
    });

    var idx = document.querySelector('.top__idx');
    if (idx) {
      idx.addEventListener('click', function (e) { if (e.target.closest('a')) idx.removeAttribute('open'); });
      document.addEventListener('click', function (e) { if (idx.open && !idx.contains(e.target)) idx.removeAttribute('open'); });
    }

    window.addEventListener('beforeprint', function () {
      Array.prototype.forEach.call(document.querySelectorAll('details'), function (d) { d.open = true; });
    });
  })();
</script>
